#!/usr/bin/env bash
set -euo pipefail

shell=${PI_HOST_SHELL:-bash}
rc_file=${PI_HOST_RC_FILE:-/tmp/pi-host-shellrc}
no_rc_config=${PI_NO_RC_CONFIG:-0}

case $shell in
  bash)
    if [[ $no_rc_config == 1 ]]; then
      if (($#)); then
        exec bash --noprofile --norc -i -c 'exec "$@"' pi-shell-launch "$@"
      fi
      exec bash --noprofile --norc -i
    fi
    if (($#)); then
      exec bash --rcfile "$rc_file" -i -c 'exec "$@"' pi-shell-launch "$@"
    fi
    exec bash --rcfile "$rc_file" -i
    ;;
  zsh)
    if [[ $no_rc_config == 1 ]]; then
      if (($#)); then
        exec zsh -f -i -c 'exec "$@"' pi-shell-launch "$@"
      fi
      exec zsh -f -i
    fi
    # zsh must run as a child so the temporary ZDOTDIR can be removed when it
    # exits; its exit status is preserved.
    zdotdir=$(mktemp -d "${TMPDIR:-/tmp}/pi-shell-launch.XXXXXX")
    cleanup_zdotdir() {
      rm -rf -- "$zdotdir"
    }
    trap cleanup_zdotdir EXIT
    ln -s "$rc_file" "$zdotdir/.zshrc"
    shell_arguments=(-i)
    if (($#)); then shell_arguments+=(-c 'exec "$@"' pi-shell-launch "$@"); fi
    if ZDOTDIR=$zdotdir zsh "${shell_arguments[@]}"; then
      status=0
    else
      status=$?
    fi
    cleanup_zdotdir
    trap - EXIT
    exit "$status"
    ;;
  *)
    printf 'pi-shell-launch: unsupported shell: %s\n' "$shell" >&2
    exit 2
    ;;
esac
