#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'usage: pi-shell-rc --shell bash|zsh --home HOST_HOME --output GENERATED_RC\n' >&2
  exit 2
}

shell=''
home=''
output=''
while (($#)); do
  case $1 in
    --shell) (($# >= 2)) || usage; shell=$2; shift 2 ;;
    --home) (($# >= 2)) || usage; home=$2; shift 2 ;;
    --output) (($# >= 2)) || usage; output=$2; shift 2 ;;
    *) usage ;;
  esac
done

[[ -n $shell && -n $home && -n $output ]] || usage
[[ $home = /* ]] || { printf 'pi-shell-rc: home must be absolute: %s\n' "$home" >&2; exit 2; }
[[ $output = /* ]] || { printf 'pi-shell-rc: output must be absolute: %s\n' "$output" >&2; exit 2; }
home=$(cd -P -- "$home" 2>/dev/null && pwd -P) || {
  printf 'pi-shell-rc: home must be a readable directory: %s\n' "$home" >&2
  exit 2
}
case $shell in
  bash) roots=("$home/.bash_profile" "$home/.bashrc") ;;
  zsh) roots=("$home/.zshenv" "$home/.zprofile" "$home/.zshrc" "$home/.zlogin") ;;
  *) printf 'pi-shell-rc: unsupported shell: %s\n' "$shell" >&2; exit 2 ;;
esac

declare -A visited=()
declare -A active=()

warn() { printf 'pi-shell-rc: %s\n' "$*" >&2; }

strip_target() {
  local rest=$1 target
  local double_quoted='^"([^"]*)"[[:space:]]*$'
  local single_quoted="^'([^']*)'[[:space:]]*$"
  if [[ $rest =~ $double_quoted ]]; then
    target=${BASH_REMATCH[1]}
  elif [[ $rest =~ $single_quoted ]]; then
    target=${BASH_REMATCH[1]}
  elif [[ $rest =~ ^([^[:space:];\&\|]+)[[:space:]]*$ ]]; then
    target=${BASH_REMATCH[1]}
  else
    return 1
  fi
  printf '%s' "$target"
}

canonical_file() {
  local path=$1 link directory base
  while [[ -L $path ]]; do
    link=$(readlink "$path") || return 1
    if [[ $link = /* ]]; then
      path=$link
    else
      path=$(dirname "$path")/$link
    fi
  done
  directory=$(cd -P -- "$(dirname "$path")" 2>/dev/null && pwd -P) || return 1
  base=$(basename "$path")
  [[ -f $directory/$base && -r $directory/$base ]] || return 1
  printf '%s/%s' "$directory" "$base"
}

resolve_target() {
  local target=$1 path canonical
  [[ $target != *'$('* && $target != *'`'* && $target != *'${'* && $target != *'['* && $target != *']'* && $target != *'?'* && $target != *'*'* ]] || return 1
  case $target in
    '~') path=$home ;;
    '~/'*) path=$home/${target#'~'/} ;;
    '$HOME') path=$home ;;
    '$HOME/'*) path=$home/${target#'$HOME'/} ;;
    '${HOME}') path=$home ;;
    '${HOME}/'*) path=$home/${target#'${HOME}'/} ;;
    /*) path=$target ;;
    *) return 1 ;;
  esac
  canonical=$(canonical_file "$path") || return 1
  case $canonical in
    "$home"|"$home"/*) ;;
    *) return 1 ;;
  esac
  printf '%s' "$canonical"
}

extract_source() {
  local line=$1 rest
  if [[ $line =~ ^[[:space:]]*(source|\.)[[:space:]]+(.+)$ ]]; then
    rest=${BASH_REMATCH[2]}
  else
    if [[ $line =~ ^[[:space:]]*(if|while|until|for|case)[[:space:]] && $line =~ (^|[[:space:];])(source|\.)[[:space:]] ]]; then
      return 2
    fi
    return 1
  fi
  strip_target "$rest" || return 2
}

is_control_start() {
  local line=$1
  [[ $line =~ ^[[:space:]]*(if|for|while|until|case|select)[[:space:]] ]] ||
    [[ $line =~ ^[[:space:]]*function[[:space:]]+[[:alnum:]_]+ ]] ||
    [[ $line =~ ^[[:space:]]*[[:alpha:]_][[:alnum:]_]*\(\)[[:space:]]*\{ ]]
}

is_control_end() {
  local line=$1
  [[ $line =~ ^[[:space:]]*(fi|done|esac|\})($|[[:space:];]) ]]
}

resolve_file() {
  local file=$1 line target path status conditional_depth=0
  if [[ ${active[$file]+yes} ]]; then
    warn "cyclic source omitted: $file"
    return
  fi
  if [[ ${visited[$file]+yes} ]]; then
    return
  fi
  visited[$file]=1
  active[$file]=1
  while IFS= read -r line || [[ -n $line ]]; do
    if (( conditional_depth > 0 )) && [[ $line =~ ^[[:space:]]*(source|\.)($|[[:space:]]) ]]; then
      printf '%s\n' "$line"
      warn "unresolved source in $file: $line"
    elif target=$(extract_source "$line"); then
      if path=$(resolve_target "$target"); then
        resolve_file "$path"
      else
        printf '%s\n' "$line"
        warn "unresolved source in $file: $line"
      fi
    else
      status=$?
      printf '%s\n' "$line"
      if (( status == 2 )); then
        warn "unresolved source in $file: $line"
      fi
    fi
    if is_control_start "$line"; then
      conditional_depth=$((conditional_depth + 1))
    fi
    if is_control_end "$line" && (( conditional_depth > 0 )); then
      conditional_depth=$((conditional_depth - 1))
    fi
  done < "$file"
  unset 'active[$file]'
}

umask 077
mkdir -p "$(dirname "$output")"
temporary=$(mktemp "${output}.XXXXXX")
trap 'rm -f "$temporary"' EXIT
: > "$temporary"
for root in "${roots[@]}"; do
  if [[ -r $root && -f $root ]]; then
    resolve_file "$root"
  else
    warn "missing startup rc: $root"
  fi
done > "$temporary"
chmod 0644 "$temporary"
mv -f "$temporary" "$output"
trap - EXIT
