#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'usage: pi-shell-rc --shell bash|zsh --home HOST_HOME --output GENERATED_RC\n' >&2
  exit 2
}

shell=''
home=''
output=''
while (($#)); do
  case $1 in
    --shell) (($# >= 2)) || usage; shell=$2; shift 2 ;;
    --home) (($# >= 2)) || usage; home=$2; shift 2 ;;
    --output) (($# >= 2)) || usage; output=$2; shift 2 ;;
    *) usage ;;
  esac
done

[[ -n $shell && -n $home && -n $output ]] || usage
case $shell in
  bash) roots=("$home/.bash_profile" "$home/.bashrc") ;;
  zsh) roots=("$home/.zshenv" "$home/.zprofile" "$home/.zshrc" "$home/.zlogin") ;;
  *) printf 'pi-shell-rc: unsupported shell: %s\n' "$shell" >&2; exit 2 ;;
esac

[[ $home = /* ]] || { printf 'pi-shell-rc: home must be absolute: %s\n' "$home" >&2; exit 2; }
[[ $output = /* ]] || { printf 'pi-shell-rc: output must be absolute: %s\n' "$output" >&2; exit 2; }

declare -A visited=()
declare -A active=()

warn() { printf 'pi-shell-rc: %s\n' "$*" >&2; }

strip_target() {
  local rest=$1 target suffix
  local double_quoted='^"([^"]*)"([[:space:]]*(;[[:space:]]*(then|fi))?[[:space:]]*)$'
  local single_quoted="^'([^']*)'([[:space:]]*(;[[:space:]]*(then|fi))?[[:space:]]*)$"
  if [[ $rest =~ $double_quoted ]]; then
    target=${BASH_REMATCH[1]}
  elif [[ $rest =~ $single_quoted ]]; then
    target=${BASH_REMATCH[1]}
  elif [[ $rest =~ ^([^[:space:];\&\|]+)[[:space:]]*$ ]]; then
    target=${BASH_REMATCH[1]}
  else
    return 1
  fi
  printf '%s' "$target"
}

resolve_target() {
  local target=$1 path
  case $target in
    '~') path=$home ;;
    '~/'*) path=$home/${target#'~'/} ;;
    '$HOME') path=$home ;;
    '$HOME/'*) path=$home/${target#'$HOME'/} ;;
    '${HOME}') path=$home ;;
    '${HOME}/'*) path=$home/${target#'${HOME}'/} ;;
    /*) path=$target ;;
    *) return 1 ;;
  esac
  case $path in
    "$home"|"$home"/*) ;;
    *) return 1 ;;
  esac
  [[ -f $path && -r $path ]] || return 1
  printf '%s' "$path"
}

extract_source() {
  local line=$1 rest
  local conditional='^[[:space:]]*if[[:space:]].*[[:space:];]then[[:space:]]+(source|\.)[[:space:]]+(.+)$'
  # Directives and the common `then source ...` conditional form are accepted.
  if [[ $line =~ ^[[:space:]]*(source|\.)[[:space:]]+(.+)$ ]]; then
    rest=${BASH_REMATCH[2]}
  elif [[ $line =~ $conditional ]]; then
    rest=${BASH_REMATCH[2]}
  else
    return 1
  fi
  strip_target "$rest"
}

resolve_file() {
  local file=$1 line target path
  if [[ ${active[$file]+yes} ]]; then
    warn "cyclic source omitted: $file"
    return
  fi
  if [[ ${visited[$file]+yes} ]]; then
    return
  fi
  visited[$file]=1
  active[$file]=1
  while IFS= read -r line || [[ -n $line ]]; do
    if target=$(extract_source "$line"); then
      if path=$(resolve_target "$target"); then
        resolve_file "$path"
      else
        printf '%s\n' "$line"
        warn "unresolved source in $file: $line"
      fi
    else
      printf '%s\n' "$line"
    fi
  done < "$file"
  unset 'active[$file]'
}

umask 077
mkdir -p "$(dirname "$output")"
temporary=$output.$$
trap 'rm -f "$temporary"' EXIT
: > "$temporary"
for root in "${roots[@]}"; do
  if [[ -r $root && -f $root ]]; then
    resolve_file "$root"
  else
    warn "missing startup rc: $root"
  fi
done > "$temporary"
chmod 0644 "$temporary"
mv -f "$temporary" "$output"
trap - EXIT
