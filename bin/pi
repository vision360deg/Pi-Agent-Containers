#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
  SOURCE="$(readlink -- "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done

STACK_ROOT="$(cd -P -- "$(dirname -- "$SOURCE")/.." && pwd)"
WORKSPACE="${PI_WORKSPACE:-$PWD}"
ORIGINAL_ARG_COUNT=$#
HELP_REQUESTED=false
HELP_SCAN_PASSTHROUGH=false
for arg in "$@"; do
  if [[ "$HELP_SCAN_PASSTHROUGH" == true ]]; then
    continue
  fi
  if [[ "$arg" == "-" ]]; then
    HELP_SCAN_PASSTHROUGH=true
    continue
  fi
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    HELP_REQUESTED=true
    break
  fi
done

REMOVE_AFTER_RUN=false
REPLACE_CONTAINER=false
KEEP_EXISTING=false
NEW_STATE=false
SEED_STATE=false
LATEST_STATE=false
OAUTH_CALLBACK=false
WORKSPACE_OPTION=false
FORCE_BASH=false
FORCE_ZSH=false
NO_RC_CONFIG=0
SHELL_COMMAND=false
SHELL_AS_ROOT=false
SHELL_START_NEW_PROJECT=false
COPY_COMMAND=false
COPY_FROM=false
COPY_TO=false
COPY_SESSIONS=false
COPY_AUTH=false
COPY_EXTENSIONS=false
COPY_ALL=false
COPY_OVERRIDE=false
PI_PASSTHROUGH_MARKER=false
WORKSPACE_MISSING=false
OAUTH_CALLBACK_PORTS=(1455 53692 51121)
OAUTH_EXTRA_PORTS=()
OAUTH_OVERRIDE_FILE=""
PI_BROWSER_EXTENSION_SOURCE="npm:pi-agent-browser-native"

oauth_port_is_known() {
  [[ "$1" == 1455 || "$1" == 53692 || "$1" == 51121 ]]
}

oauth_append_port() {
  local raw_port="$1"
  local source="$2"
  local port
  local existing

  if ! [[ "$raw_port" =~ ^[0-9]+$ ]]; then
    printf 'pi: invalid OAuth callback port in %s: %s\n' "$source" "$raw_port" >&2
    return 2
  fi

  port=$((10#$raw_port))
  if (( port < 1 || port > 65535 )); then
    printf 'pi: OAuth callback port must be between 1 and 65535 in %s: %s\n' "$source" "$raw_port" >&2
    return 2
  fi

  for existing in "${OAUTH_CALLBACK_PORTS[@]}"; do
    if [[ "$existing" == "$port" ]]; then
      return 0
    fi
  done

  OAUTH_CALLBACK_PORTS+=("$port")
  if ! oauth_port_is_known "$port"; then
    OAUTH_EXTRA_PORTS+=("$port")
  fi
}

oauth_parse_port_list() {
  local list="$1"
  local source="$2"
  local normalized
  local token
  local -a tokens=()

  normalized="${list//$'\n'/ }"
  normalized="${normalized//,/ }"
  if [[ -z "${normalized//[[:space:]]/}" ]]; then
    return 0
  fi

  read -r -a tokens <<< "$normalized"
  for token in "${tokens[@]}"; do
    oauth_append_port "$token" "$source" || return $?
  done
}

oauth_cli_token_is_port_list() {
  [[ "$1" =~ ^[0-9]+(,[0-9]+)*,?$ ]]
}

create_oauth_override() {
  local port

  [[ "${#OAUTH_EXTRA_PORTS[@]}" -gt 0 ]] || return 0
  OAUTH_OVERRIDE_FILE="$(mktemp "${TMPDIR:-/tmp}/pi-oauth.XXXXXX")"
  {
    printf 'services:\n'
    printf '  pi:\n'
    printf '    ports:\n'
    for port in "${OAUTH_EXTRA_PORTS[@]}"; do
      printf '      - "127.0.0.1:%s:%s"\n' "$port" "$port"
      printf '      - "[::1]:%s:%s"\n' "$port" "$port"
    done
  } > "$OAUTH_OVERRIDE_FILE"
  trap '[[ -z "${OAUTH_OVERRIDE_FILE:-}" || ! -e "$OAUTH_OVERRIDE_FILE" ]] || rm -f -- "$OAUTH_OVERRIDE_FILE"' EXIT
}

# These are wrapper options, so consume them before passing the remaining
# arguments to Pi. Keeping them here also lets `pi --replace --help` take the
# local brief-help path without starting Docker. Help invocations skip parsing
# entirely so even `pi --workspace --help` remains a local brief-help request.
if [[ "$HELP_REQUESTED" == false ]]; then
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --rm)
        REMOVE_AFTER_RUN=true
        shift
        ;;
      --replace)
        REPLACE_CONTAINER=true
        shift
        ;;
      --keep-existing)
        KEEP_EXISTING=true
        shift
        ;;
      --new-state)
        NEW_STATE=true
        shift
        ;;
      --seed)
        SEED_STATE=true
        shift
        ;;
      --latest-state)
        LATEST_STATE=true
        shift
        ;;
      --bash)
        FORCE_BASH=true
        shift
        ;;
      --zsh)
        FORCE_ZSH=true
        shift
        ;;
      --no-rc-config)
        NO_RC_CONFIG=1
        shift
        ;;
      --oauth)
        OAUTH_CALLBACK=true
        shift
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --*)
              break
              ;;
            *,*|[0-9]*)
              if ! oauth_cli_token_is_port_list "$1"; then
                printf 'pi: invalid OAuth callback port list: %s\n' "$1" >&2
                exit 2
              fi
              oauth_parse_port_list "$1" '--oauth' || exit $?
              shift
              ;;
            *)
              break
              ;;
          esac
        done
        ;;
      --oauth=*)
        OAUTH_CALLBACK=true
        oauth_value="${1#--oauth=}"
        if [[ -n "$oauth_value" ]]; then
          oauth_cli_token_is_port_list "$oauth_value" || {
            printf 'pi: invalid OAuth callback port list: %s\n' "$oauth_value" >&2
            exit 2
          }
          oauth_parse_port_list "$oauth_value" '--oauth' || exit $?
        fi
        shift
        ;;
      --workspace)
        if [[ "$#" -lt 2 ]]; then
          printf 'pi: --workspace requires a path\n' >&2
          printf 'usage: pi [--workspace PATH] [PI_ARGS...]\n' >&2
          exit 2
        fi
        WORKSPACE="$2"
        WORKSPACE_OPTION=true
        shift 2
        ;;
      --workspace=*)
        WORKSPACE="${1#--workspace=}"
        if [[ -z "$WORKSPACE" ]]; then
          printf 'pi: --workspace requires a path\n' >&2
          printf 'usage: pi [--workspace PATH] [PI_ARGS...]\n' >&2
          exit 2
        fi
        WORKSPACE_OPTION=true
        shift
        ;;
      *)
        break
        ;;
    esac
  done
fi

print_detailed_help() {
  cat <<'EOF'
Containerized Pi wrapper

Usage:
  pi [--bash|--zsh] [--no-rc-config] [--oauth [PORTS...]] [--replace] [--keep-existing] [PI_ARGS...]
  pi [--bash|--zsh] [--no-rc-config] --oauth [PORTS...] --rm [PI_ARGS...]
  pi stop
  pi update [--extensions] [--models]
  pi list
  pi remove [--all]
  pi shell [--root|-r]
  pi copy [--from] [--to] [--sessions, -s] [--auth, -a] [--extensions, -e] [--all] [--override]
  pi - PI_ARGS...

Description:
  Runs Pi inside a persistent Docker Compose service scoped to the current
  workspace while keeping the terminal attached to the Pi process.

  With no command, the workspace's persistent Pi service is started or reused
  and Pi is executed inside it. The current host directory is mounted at
  /workspace. Each workspace has its own Compose project and Pi/browser state.

  Before Compose starts, the wrapper provisions the workspace's named volumes
  and treats them as external so existing state is never recreated because of
  a metadata change. It also repairs ownership and write permissions for the
  agent, session, and browser volumes before launching Pi.

  Before each Pi run, the wrapper ensures the pi-agent-browser-native package is
  installed in the mounted workspace agent state. The package exposes Pi's
  native agent_browser tool while using the container's upstream agent-browser
  CLI and Chromium.

Options:
  -h, --help
      Show this detailed help. Help is handled locally and does not start
      Docker.

  --rm
      Run Pi in a disposable one-off container. The container is removed after
      Pi exits. This mode does not use the persistent service.

  --replace
      Force-recreate the persistent container for the current workspace.

  --keep-existing
      When another workspace has the same basename, preserve its container
      unchanged and create the current workspace with a disambiguated name.

  --workspace PATH, --workspace=PATH
      Use PATH as the workspace instead of the current invocation directory.
      Takes precedence over PI_WORKSPACE.
      Relative paths resolve from the directory where pi is invoked.

  --new-state
      Use an empty workspace-specific Pi agent-state volume for this run instead
      of copying agent-state files from the workspace currently designated as the
      seed. Workspace sessions remain isolated.

  --seed
      Promote this workspace's agent state to the default seed used by future
      workspaces. On the first-ever stack, it is also the newest managed state.

  --latest-state
      When initializing a new workspace, copy from the newest Docker-managed
      state volume instead of the seed. Once this workspace already has
      initialized state, this option has no effect and prints a warning.

  --bash, --zsh
      Force Bash or zsh for foreground Pi and shell processes instead of using
      the basename of the host SHELL value. These options are mutually exclusive.

  --no-rc-config
      Start the selected Bash or zsh without loading host startup configuration.
      This can be combined with either shell override.

  --oauth [PORTS...]
      Add the Compose override that publishes host loopback ports for browser
      OAuth callbacks. Known fixed callbacks 1455 (OpenAI Codex), 53692
      (Anthropic), and 51121 (pi-antigravity) are always published. Add custom
      fixed ports as a
      comma- or space-separated list, for example --oauth 7000,7001 or
      --oauth 7000 7001. PI_OAUTH_CALLBACK_PORTS adds ports from the
      environment. Without this option, stacks do not publish host ports.

Commands:
  stop
      Stop only the persistent Compose project for the current workspace.
      Containers, networks, and named volumes are not removed.

  remove
      Remove the current workspace's Compose project. Pi and browser state
      volumes are preserved.

  remove --all
      Remove the current workspace's Compose project and its persisted Pi and
      browser state volumes. Other workspace state volumes are unaffected. The
      host workspace files are never removed.

  update
      Rebuild the Pi image without using the Docker build cache, then
      force-recreate the persistent service for the current workspace.

  update --extensions
      Start the persistent service and run Pi's extension update command.

  update --models
      Start the persistent service and update Pi's model catalogs.

  update --extensions --models
      Update both Pi-managed extensions and model catalogs.

  list
      List running and stopped persistent Pi stacks with workspace, project,
      Docker creation/start timestamps, agent-state volume, and seed/latest markers.
      The started timestamp uses Docker State.StartedAt; zero means started: never.

  shell [--root|-r]
      Open the selected interactive Bash or zsh in the current workspace's Pi
      container. If no container matches the current workspace, show a picker
      containing all existing persistent Pi containers. A stopped selection is started
      before the shell opens. When no current workspace container exists, the picker
      also offers `0) Start a new project` and ends with `X) Press Esc to cancel`.
      Choosing 0 creates the workspace, starts its persistent Pi service, and opens
      the shell there.

      -r, --root
          Open the shell as Docker user 0 (root) instead of the image's node user.

  copy [--from] [--to] [--sessions, -s] [--auth, -a] [--extensions, -e] [--all] [--override]
      Copy agent state between existing Pi workspace containers using a
      disposable helper container. By default the current workspace is the
      destination and a picker selects the source. --to makes the current
      workspace the source and picks the destination; --from picks the source.
      Without a category flag, sessions, provider auth, and extensions are
      copied. Category flags restrict the copy. --all skips item pickers.
      Copies are additive; duplicate items prompt with r=replace, s=skip,
      a=replace all, q=cancel. --override replaces duplicates automatically.

Pi passthrough:
  Arguments not recognized as wrapper options or commands are passed directly to
  Pi inside the workspace container. For example:

  pi install npm:pi-web-access
      Install a Pi package into this workspace's persisted agent state.

  Wrapper commands take precedence when names collide: stop, update, list, remove,
  and shell are handled by this wrapper rather than passed to Pi.

  A leading `-` forces the following arguments through to Pi, even when the
  first argument is also a wrapper command. For example, `pi - list` runs Pi's
  `list` command inside the container; `pi list` runs this wrapper's inventory.

Workspace:
  PI_WORKSPACE=/path/to/project pi
      Mount /path/to/project at /workspace inside its workspace container.

  Without PI_WORKSPACE, the directory from which pi is invoked is used.

  Workspace selection precedence is: --workspace PATH, then PI_WORKSPACE, then
  the directory from which pi is invoked.

  Persistent containers are named pi-agents-pi-<workspace-basename>. If two
  different workspaces have the same basename, pi prompts before expanding
  the names with the first differing path component.

  Compose projects are named pi-agents-pi-<workspace-basename>. If another
  workspace has the same basename, the first differing path component is
  added to the project name. Pi, session, and browser volumes retain stable
  internal namespaces so renaming the project does not create fresh state.

  Each workspace gets its own agent-state volume. On first creation, its agent
  files are copied from an existing normal workspace state volume; the sessions
  directory is intentionally excluded. Later changes stay isolated to that
  workspace. Use --new-state to start empty instead of copying agent-state files
  from the workspace currently designated as the seed.

  The first stack becomes the seed. Later stacks copy the seed by default.
  Docker volume creation metadata identifies the latest-created state for
  --latest-state. Use --seed to promote a workspace to the seed. If the seed
  pointer is missing while managed state volumes exist, pi warns, proposes the
  oldest managed state volume as the seed, and asks for confirmation before continuing.

  Existing running and stopped containers are both considered during collision
  checks.

Host shell:
  Foreground Pi commands and `pi shell` use Bash or zsh based on the basename
  of the host SHELL value. Use --bash or --zsh to override that choice.

  For Bash, .bash_profile and .bashrc are startup roots. For zsh, .zshenv,
  .zprofile, .zshrc, and .zlogin are startup roots. Statically identifiable
  source and dot references are recursively resolved on the host into one
  generated rc file, which is mounted read-only without mounting the host home.
  Use --no-rc-config to disable both generation and startup-file loading.

  The persistent container service bootstrap remains Bash; host-shell selection
  applies only to foreground Pi commands and interactive shell attachment.

Logging:
  Persistent Pi session records are streamed as readable, colored events to
  the Docker service log stream while Pi runs. The session volume remains the
  durable JSONL source. Set PI_SESSION_LOG_FORMAT=raw for JSONL logs or
  PI_SESSION_LOG_COLOR=never for plain text.

  Follow it with:
    docker compose --project-name <readable-workspace-project> logs --follow --timestamps pi

Examples:
  pi                                 # Start or reuse the current workspace container.
  pi "Inspect this project"          # Start Pi and send it an initial prompt.
  pi --oauth                         # Publish known browser OAuth callback ports.
  pi --oauth 7000,7001               # Also publish two custom callback ports.
  pi --oauth 7000 7001               # Space-separated form of the same list.
  pi --rm                            # Run Pi in a disposable one-off container.
  pi --replace                       # Force-recreate the current workspace container.
  pi --keep-existing                 # Preserve a colliding existing container.
  pi --new-state                     # Start empty; skip copying from the seed workspace.
  pi --seed                          # Promote this workspace's state to the seed.
  pi --latest-state                  # Copy latest state when initializing this workspace.
  pi --workspace ~/src/project       # Use an explicit workspace path.
  PI_WORKSPACE="$PWD" pi             # Use an explicit host directory as the workspace.
  pi stop                            # Stop only the current workspace project.
  pi update                          # Rebuild the image and recreate the service.
  pi update --extensions             # Update Pi-managed extensions.
  pi update --models                 # Update Pi's model catalogs.
  pi list                             # Inventory persistent Pi stacks without changing Docker state.
  pi remove                          # Remove the stack but preserve persisted state.
  pi remove --all                    # Also remove Pi and browser persisted state.
  pi shell                           # Open a shell in the current workspace container.
  pi shell --root                    # Open the current or selected container as root.
  pi copy                            # Pick a source and copy all state to this workspace.
  pi copy --to                       # Pick a destination and copy all state from this workspace.
  pi copy -s --all                   # Copy every session without selecting individual files.
  pi copy --auth --override          # Copy provider auth and replace duplicates automatically.
  pi - list                          # Run Pi's list command inside the container.

Help behavior:
  Exact `pi -h` and `pi --help` commands show this detailed help.

  When a help flag is combined with another argument, pi prints only the brief
  usage summary instead.

Restrictions:
  --rm cannot be combined with stop, update, remove, --replace, or --keep-existing.
  --oauth is optional; only one simultaneous stack can publish any selected host
  callback port. PI_OAUTH_CALLBACK_PORTS accepts comma- or space-separated ports.
  --replace and --keep-existing apply to persistent workspace containers only.
  remove accepts only the optional --all flag; --all also removes persisted state.
  list accepts no positional arguments and does not change Docker state.
  shell accepts only -r/--root. When a current workspace container exists it
  reuses or starts it without creating Compose resources. Otherwise it offers
  0 to create/start the current workspace and X/Escape to cancel.
  --new-state cannot be combined with stop or remove.
  --latest-state only affects first initialization of a workspace and warns
  after that workspace already has initialized state. It selects the newest
  managed Docker state volume rather than a second pointer file.
  --seed promotes the current state to the seed. The seed pointer is stored in
  ~/.config/pi-agent-containers/seed by default.
  PI_AGENT_CONTAINERS_CONFIG_PATH overrides the seed-pointer directory when needed.
  If remove --all deletes the seed state, pi repoints the seed to the oldest
  remaining managed state volume, or clears it when none remain.
  A basename collision prompts for action and defaults to cancel.
EOF
}

print_brief_usage() {
  cat <<'EOF'
Usage:
  pi [-h|--help]
  pi [--bash|--zsh] [--no-rc-config] [--oauth [PORTS...]] [--replace] [--keep-existing] [PI_ARGS...]
  pi [--bash|--zsh] [--no-rc-config] --oauth [PORTS...] --rm [PI_ARGS...]
  pi stop
  pi update [--extensions] [--models]
  pi list
  pi remove [--all]
  pi shell [--root|-r]
  pi copy [--from] [--to] [--sessions, -s] [--auth, -a] [--extensions, -e] [--all] [--override]
  pi - PI_ARGS...

Options:
  -h, --help        Show detailed help when used alone.
  --rm              Run Pi in a disposable one-off container.
  --replace         Force-recreate the current workspace container.
  --keep-existing   Preserve an existing colliding workspace container.
  --workspace PATH  Use PATH as the workspace; it overrides PI_WORKSPACE.
  --new-state       Start empty; skip copying agent-state files from the seed workspace.
  --seed            Promote this workspace's state to the default seed state.
  --latest-state    Copy the newest Docker-managed state when initializing.
  --oauth [PORTS...] Publish known callback ports 1455/53692/51121; add comma- or
                     space-separated custom ports.
  --bash, --zsh      Force Bash or zsh instead of detecting SHELL.
  --no-rc-config     Start the selected shell without host startup files.

  State volumes     Private per workspace; existing contents are preserved and
                    permissions are repaired before Pi starts.
  Browser integration Ensures pi-agent-browser-native is installed by default.
  Logging           Streams pretty colored session events to Docker logs by
                    default; use PI_SESSION_LOG_FORMAT=raw for JSONL.
  Shell             Detects Bash/zsh from SHELL and recursively resolves the
                    matching host startup files into a read-only generated rc.
  Pi passthrough     Other arguments are passed to Pi in the workspace container.
                     Example: pi install npm:pi-web-access
                     Use `pi - PI_ARGS...` to force wrapper command names through
                     to Pi, for example: pi - list

Commands:
  stop              Stop the current workspace's persistent project.
  update            Rebuild Pi or update extensions/models.
  list              List running and stopped persistent Pi stacks (read-only).
  remove [--all]    Remove the current stack; --all also removes persisted state.
  shell [--root|-r] Open a shell in the current or selected Pi container.
  copy              Copy selected agent state between existing Pi containers.

Run `pi --help` for detailed usage.
EOF
}

if [[ "$HELP_REQUESTED" == true ]]; then
  if [[ "$ORIGINAL_ARG_COUNT" -eq 1 ]]; then
    print_detailed_help
  else
    print_brief_usage
  fi
  exit 0
fi

if [[ "$HELP_REQUESTED" == false && "${1:-}" == "copy" ]]; then
  COPY_COMMAND=true
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from) COPY_FROM=true; shift ;;
      --to) COPY_TO=true; shift ;;
      -s|--sessions) COPY_SESSIONS=true; shift ;;
      -a|--auth) COPY_AUTH=true; shift ;;
      -e|--extensions) COPY_EXTENSIONS=true; shift ;;
      --all) COPY_ALL=true; shift ;;
      --override) COPY_OVERRIDE=true; shift ;;
      *)
        printf 'pi: unsupported copy option: %s\n' "$1" >&2
        printf 'usage: pi copy [--from] [--to] [-s|--sessions] [-a|--auth] [-e|--extensions] [--all] [--override]\n' >&2
        exit 2
        ;;
    esac
  done
fi

if [[ "$HELP_REQUESTED" == false && "${1:-}" == "shell" ]]; then
  SHELL_COMMAND=true
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -r|--root)
        SHELL_AS_ROOT=true
        shift
        ;;
      *)
        printf 'pi: unsupported shell option: %s\n' "$1" >&2
        printf 'usage: pi shell [--root|-r]\n' >&2
        exit 2
        ;;
    esac
  done
fi

if [[ "$HELP_REQUESTED" == false && "${1:-}" == "-" ]]; then
  PI_PASSTHROUGH_MARKER=true
  shift
  if [[ $# -eq 0 ]]; then
    printf 'pi: - requires a Pi command\n' >&2
    printf 'usage: pi - PI_ARGS...\n' >&2
    exit 2
  fi
fi

if [[ "$SHELL_COMMAND" == true &&
  ( "$REMOVE_AFTER_RUN" == true || "$REPLACE_CONTAINER" == true ||
    "$KEEP_EXISTING" == true || "$NEW_STATE" == true || "$SEED_STATE" == true ||
    "$LATEST_STATE" == true || "$OAUTH_CALLBACK" == true ) ]]; then
  printf 'pi: shell cannot be combined with lifecycle, state, or OAuth options\n' >&2
  printf 'usage: pi shell [--root|-r]\n' >&2
  exit 2
fi

if [[ "$OAUTH_CALLBACK" == true ]]; then
  oauth_parse_port_list "${PI_OAUTH_CALLBACK_PORTS:-}" 'PI_OAUTH_CALLBACK_PORTS' || exit $?
  create_oauth_override
fi

LIST_COMMAND=false
if [[ "$PI_PASSTHROUGH_MARKER" == false && "${1:-}" == "list" ]]; then
  if [[ "$#" -ne 1 || "$REMOVE_AFTER_RUN" == true || "$REPLACE_CONTAINER" == true || "$KEEP_EXISTING" == true || "$NEW_STATE" == true || "$SEED_STATE" == true || "$LATEST_STATE" == true || "$OAUTH_CALLBACK" == true || "${WORKSPACE_OPTION:-false}" == true ]]; then
    printf 'usage: pi list\n' >&2
    exit 2
  fi
  LIST_COMMAND=true
fi

if [[ "$REMOVE_AFTER_RUN" == true && "$REPLACE_CONTAINER" == true ]]; then
  printf 'pi: --rm cannot be combined with --replace\n' >&2
  exit 2
fi

if [[ "$REMOVE_AFTER_RUN" == true && "$KEEP_EXISTING" == true ]]; then
  printf 'pi: --rm cannot be combined with --keep-existing\n' >&2
  exit 2
fi

if [[ "$REMOVE_AFTER_RUN" == true && ( "$SEED_STATE" == true || "$LATEST_STATE" == true ) ]]; then
  printf 'pi: --seed and --latest-state require a persistent workspace stack\n' >&2
  exit 2
fi

if [[ "$PI_PASSTHROUGH_MARKER" == false && "${1:-}" == "stop" ]]; then
  if [[ "$REMOVE_AFTER_RUN" == true ]]; then
    printf 'pi: --rm cannot be combined with stop; stop targets the persistent service\n' >&2
    exit 2
  fi
  if [[ "$REPLACE_CONTAINER" == true || "$KEEP_EXISTING" == true || "$NEW_STATE" == true || "$SEED_STATE" == true || "$LATEST_STATE" == true ]]; then
    printf 'pi: --replace, --keep-existing, --new-state, --seed, and --latest-state cannot be combined with stop\n' >&2
    exit 2
  fi

  if [[ "$#" -ne 1 ]]; then
    printf 'usage: pi stop\n' >&2
    exit 2
  fi
fi

if [[ "$PI_PASSTHROUGH_MARKER" == false && "${1:-}" == "update" && ( "$REPLACE_CONTAINER" == true || "$KEEP_EXISTING" == true ) ]]; then
  printf 'pi: --replace and --keep-existing cannot be combined with update\n' >&2
  exit 2
fi

workspace_path_with_missing_components() {
  local path="$1"
  local suffix=""
  local base
  local parent

  if [[ "$path" != /* ]]; then
    path="$PWD/$path"
  fi

  while [[ ! -d "$path" ]]; do
    base="$(basename -- "$path")"
    [[ -n "$base" && "$base" != "/" ]] || break
    suffix="/$base$suffix"
    parent="$(dirname -- "$path")"
    [[ "$parent" != "$path" ]] || break
    path="$parent"
  done

  if [[ -d "$path" ]]; then
    path="$(cd -P -- "$path" && pwd)"
  fi
  printf '%s%s\n' "$path" "$suffix"
}

if [[ "$LIST_COMMAND" != true ]]; then
  if [[ ! -d "$WORKSPACE" ]]; then
    if [[ "$SHELL_COMMAND" == true ]]; then
      WORKSPACE_MISSING=true
      WORKSPACE="$(workspace_path_with_missing_components "$WORKSPACE")"
    else
      printf 'pi: workspace does not exist: %s\n' "$WORKSPACE" >&2
      exit 1
    fi
  else
    WORKSPACE="$(cd -P -- "$WORKSPACE" && pwd)"
  fi
fi

sanitize_slug() {
  local value="$1"
  value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9_.-]/-/g' -e 's/^[^a-z0-9]*//' -e 's/[^a-z0-9]*$//' -e 's/-\{2,\}/-/g')"
  if [[ -z "$value" ]]; then
    value="workspace"
  fi
  printf '%s' "$value"
}

workspace_basename="$(basename -- "$WORKSPACE")"
if [[ "$workspace_basename" == "/" || -z "$workspace_basename" ]]; then
  workspace_basename="root"
fi
WORKSPACE_BASENAME="$(sanitize_slug "$workspace_basename")"

workspace_hash() {
  local digest
  if command -v shasum >/dev/null 2>&1; then
    digest="$(printf '%s' "$1" | shasum -a 256 | awk '{print substr($1, 1, 12)}')"
  elif command -v sha256sum >/dev/null 2>&1; then
    digest="$(printf '%s' "$1" | sha256sum | awk '{print substr($1, 1, 12)}')"
  else
    digest="$(printf '%s' "$1" | cksum | awk '{print $1}')"
  fi
  printf '%s' "$digest"
}

PROJECT_NAME="pi-agents-pi-$WORKSPACE_BASENAME"
VOLUME_NAMESPACE="pi-agents-ws-$(workspace_hash "$WORKSPACE")"
AGENT_STATE_NAMESPACE="$VOLUME_NAMESPACE"
if [[ "$NEW_STATE" == true ]]; then
  AGENT_STATE_NAMESPACE="pi-agents-new-ws-$(workspace_hash "$WORKSPACE")"
fi
AGENT_STATE_VOLUME_NAME="${AGENT_STATE_NAMESPACE}_pi-agent-state"
SESSION_STATE_VOLUME_NAME="${VOLUME_NAMESPACE}_pi-sessions"
BROWSER_STATE_VOLUME_NAME="${VOLUME_NAMESPACE}_agent-browser-state"
CONTAINER_NAME="pi-agents-pi-$WORKSPACE_BASENAME"
CONFIG_PATH="${PI_AGENT_CONTAINERS_CONFIG_PATH:-$HOME/.config/pi-agent-containers}"
STATE_SEED_FILE="$CONFIG_PATH/seed"
if [[ "$FORCE_BASH" == true && "$FORCE_ZSH" == true ]]; then
  printf 'pi: --bash and --zsh are mutually exclusive\n' >&2
  exit 2
fi
if [[ "$FORCE_BASH" == true ]]; then
  HOST_SHELL_NAME=bash
elif [[ "$FORCE_ZSH" == true ]]; then
  HOST_SHELL_NAME=zsh
else
  HOST_SHELL_NAME="${SHELL:-/bin/bash}"
  HOST_SHELL_NAME="${HOST_SHELL_NAME##*/}"
fi
case "$HOST_SHELL_NAME" in
  bash|zsh) ;;
  *)
    printf 'pi: unsupported host shell: %s (supported: bash, zsh)\n' "$HOST_SHELL_NAME" >&2
    exit 2
    ;;
esac
SHELL_RC_DIRECTORY="$CONFIG_PATH/shell-rc"
HOST_SHELL_RC_FILE=""
if [[ "$NO_RC_CONFIG" -eq 0 ]]; then
  HOST_SHELL_RC_FILE="$SHELL_RC_DIRECTORY/${VOLUME_NAMESPACE}-${HOST_SHELL_NAME}.rc"
fi
STATE_TARGET_WAS_NEW=false
FORCE_RECREATE=false
if [[ "$REPLACE_CONTAINER" == true || "$NEW_STATE" == true ]]; then
  FORCE_RECREATE=true
fi
build_compose() {
  COMPOSE=(
    docker compose
    --project-name "$PROJECT_NAME"
    --project-directory "$STACK_ROOT"
    --file "$STACK_ROOT/compose.yml"
  )
  if [[ "$OAUTH_CALLBACK" == true ]]; then
    COMPOSE+=(--file "$STACK_ROOT/compose.oauth.yml")
    if [[ -n "$OAUTH_OVERRIDE_FILE" ]]; then
      COMPOSE+=(--file "$OAUTH_OVERRIDE_FILE")
    fi
  fi
}

build_compose

run_compose() {
  env \
    PI_WORKSPACE="$WORKSPACE" \
    PI_WORKSPACE_BASENAME="$WORKSPACE_BASENAME" \
    PI_CONTAINER_NAME="$CONTAINER_NAME" \
    PI_WORKSPACE_PROJECT="$PROJECT_NAME" \
    PI_AGENT_STATE_VOLUME_NAME="$AGENT_STATE_VOLUME_NAME" \
    PI_SESSION_STATE_VOLUME_NAME="$SESSION_STATE_VOLUME_NAME" \
    PI_BROWSER_STATE_VOLUME_NAME="$BROWSER_STATE_VOLUME_NAME" \
    PI_HOST_SHELL="$HOST_SHELL_NAME" \
    PI_HOST_RC_SOURCE="$HOST_SHELL_RC_FILE" \
    PI_HOST_RC_FILE="/tmp/pi-host-shellrc" \
    PI_NO_RC_CONFIG="$NO_RC_CONFIG" \
    "${COMPOSE[@]}" "$@"
}

prepare_host_shell_rc() {
  [[ "$NO_RC_CONFIG" -eq 0 ]] || return 0
  mkdir -p -- "$SHELL_RC_DIRECTORY"
  "$STACK_ROOT/bin/pi-shell-rc" \
    --shell "$HOST_SHELL_NAME" \
    --home "$HOME" \
    --output "$HOST_SHELL_RC_FILE"
}

read_state_pointer() {
  local file="$1"
  local value=""
  if [[ -s "$file" ]]; then
    IFS= read -r value < "$file"
  fi
  printf '%s' "$value"
}

write_state_pointer() {
  local file="$1"
  local value="$2"
  local temporary_file
  mkdir -p "$CONFIG_PATH"
  temporary_file="${file}.$$"
  printf '%s\n' "$value" > "$temporary_file"
  mv -f -- "$temporary_file" "$file"
}

clear_state_pointer() {
  local file="$1"
  if [[ -e "$file" ]]; then
    : > "$file"
  fi
}

state_volume_exists() {
  [[ -n "$1" ]] && docker volume inspect "$1" >/dev/null 2>&1
}

ensure_workspace_volumes() {
  # Compose cannot safely add or reconcile labels on an already-existing
  # named volume: it prompts to recreate the volume, which could destroy Pi
  # state. Create the volumes first and let Compose consume them as external.
  # Existing volumes are deliberately left untouched.
  if ! state_volume_exists "$AGENT_STATE_VOLUME_NAME"; then
    docker volume create \
      --label com.pi-agents.managed=true \
      --label com.pi-agents.state-kind=agent \
      --label "com.pi-agents.workspace=$WORKSPACE" \
      --label "com.pi-agents.project=$PROJECT_NAME" \
      "$AGENT_STATE_VOLUME_NAME" >/dev/null
  fi

  if ! state_volume_exists "$SESSION_STATE_VOLUME_NAME"; then
    docker volume create "$SESSION_STATE_VOLUME_NAME" >/dev/null
  fi

  if ! state_volume_exists "$BROWSER_STATE_VOLUME_NAME"; then
    docker volume create "$BROWSER_STATE_VOLUME_NAME" >/dev/null
  fi
}

state_volume_created_at() {
  local volume="$1"
  docker volume inspect --format '{{.CreatedAt}}' "$volume" 2>/dev/null
}

list_managed_state_volumes() {
  docker volume ls \
    --filter 'label=com.pi-agents.managed=true' \
    --filter 'label=com.pi-agents.state-kind=agent' \
    --format '{{.Name}}'
}

find_managed_state_volume_by_age() {
  local direction="$1"
  local excluded="${2:-}"
  local candidate
  local created_at
  local selected=""
  local selected_created_at=""

  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    [[ -n "$excluded" && "$candidate" == "$excluded" ]] && continue
    created_at="$(state_volume_created_at "$candidate" || true)"
    [[ -n "$created_at" ]] || continue
    if [[ -z "$selected" || \
      ( "$direction" == oldest && ( "$created_at" < "$selected_created_at" || \
        ( "$created_at" == "$selected_created_at" && "$candidate" < "$selected" ) ) ) || \
      ( "$direction" == newest && ( "$created_at" > "$selected_created_at" || \
        ( "$created_at" == "$selected_created_at" && "$candidate" > "$selected" ) ) ) ]]; then
      selected="$candidate"
      selected_created_at="$created_at"
    fi
  done < <(list_managed_state_volumes)

  printf '%s' "$selected"
}

find_oldest_managed_state_volume() {
  find_managed_state_volume_by_age oldest "$AGENT_STATE_VOLUME_NAME"
}

find_newest_managed_state_volume() {
  find_managed_state_volume_by_age newest "$AGENT_STATE_VOLUME_NAME"
}

find_newest_managed_state_volume_for_listing() {
  find_managed_state_volume_by_age newest
}

bootstrap_seed_pointer() {
  local seed

  seed="$(read_state_pointer "$STATE_SEED_FILE")"
  if [[ -n "$seed" ]] && ! state_volume_exists "$seed"; then
    clear_state_pointer "$STATE_SEED_FILE"
  fi
}

confirm_missing_seed_pointer() {
  local candidate="$1"
  local answer="n"

  printf 'pi: warning: the seed pointer was not found.\n' >&2
  printf 'pi: the oldest managed agent-state volume is:\n  %s\n' "$candidate" >&2
  printf 'pi: use it as the seed for this new workspace? [y/N] ' >&2
  if IFS= read -r answer; then
    case "$answer" in
      y|Y)
        write_state_pointer "$STATE_SEED_FILE" "$candidate"
        return 0
        ;;
    esac
  fi

  printf 'pi: seed selection cancelled; workspace was not started\n' >&2
  return 2
}

prepare_state_lineage() {
  local seed
  local candidate

  STATE_TARGET_WAS_NEW=false
  if state_volume_exists "$AGENT_STATE_VOLUME_NAME"; then
    return 0
  fi

  STATE_TARGET_WAS_NEW=true
  bootstrap_seed_pointer
  seed="$(read_state_pointer "$STATE_SEED_FILE")"
  if [[ -n "$seed" ]]; then
    return 0
  fi

  candidate="$(find_oldest_managed_state_volume)"
  if [[ -n "$candidate" ]]; then
    confirm_missing_seed_pointer "$candidate"
  fi
}

select_state_source() {
  local source=""
  bootstrap_seed_pointer
  if [[ "$LATEST_STATE" == true ]]; then
    source="$(find_newest_managed_state_volume)"
  else
    source="$(read_state_pointer "$STATE_SEED_FILE")"
  fi

  if [[ -n "$source" && "$source" != "$AGENT_STATE_VOLUME_NAME" ]] && state_volume_exists "$source"; then
    printf '%s' "$source"
  fi
}

state_volume_has_useful_state() {
  docker run --rm \
    -v "$AGENT_STATE_VOLUME_NAME:/state:ro" \
    alpine:latest \
    sh -c 'set -eu; auth="$(tr -d "[:space:]" < /state/auth.json 2>/dev/null || printf "{}")"; if [ "$auth" != "{}" ]; then exit 0; fi; grep -Eq "\\\"defaultProvider\\\"|\\\"defaultModel\\\"" /state/settings.json 2>/dev/null'
}

initialize_agent_state() {
  local source_volume
  local target_volume_exists=false

  # A per-workspace volume is seeded once from an existing state volume. The
  # source is mounted read-only and sessions are excluded so each workspace
  # starts with common login/configuration files but not another agent's
  # conversation history.
  if state_volume_exists "$AGENT_STATE_VOLUME_NAME"; then
    target_volume_exists=true
  fi

  if [[ "$NEW_STATE" == true && "$LATEST_STATE" == false ]]; then
    return 0
  fi

  if [[ "$target_volume_exists" == true ]] && state_volume_has_useful_state; then
    bootstrap_seed_pointer
    if [[ "$LATEST_STATE" == true ]]; then
      printf 'pi: warning: --latest-state has no effect; this workspace already has initialized agent state\n' >&2
    fi
    return 0
  fi

  source_volume="$(select_state_source)"

  if [[ -z "$source_volume" ]]; then
    return 0
  fi
  if ! docker volume inspect "$source_volume" >/dev/null 2>&1; then
    return 0
  fi

  # A previous Pi launch may have created the target volume and written only
  # fresh defaults before this wrapper had a chance to seed it. Treat that
  # specific state as uninitialized so the current workspace can recover from
  # an earlier failed copy. Never replace a target containing real auth or
  # provider/model preferences; Pi may populate models-store.json by itself
  # during startup, so that file alone is not evidence of a logged-in state.
  if [[ "$target_volume_exists" == true ]] && docker run --rm \
      -v "$AGENT_STATE_VOLUME_NAME:/state:ro" \
      alpine:latest \
      sh -c 'set -eu; auth="$(tr -d "[:space:]" < /state/auth.json 2>/dev/null || printf "{}")"; if [ "$auth" != "{}" ]; then exit 0; fi; grep -Eq "\\\"defaultProvider\\\"|\\\"defaultModel\\\"" /state/settings.json 2>/dev/null'; then
    return 0
  fi

  docker run --rm \
    -v "$source_volume:/state-source:ro" \
    -v "$AGENT_STATE_VOLUME_NAME:/state-target" \
    alpine:latest \
    sh -c 'set -eu; find /state-source -mindepth 1 -maxdepth 1 ! -name sessions -exec cp -a {} /state-target/ \; ; chown -R 1000:1000 /state-target'
}

repair_state_permissions() {
  # State volumes can predate the current image or have been written by a
  # root sidecar. Repair them before Pi starts so its node user can write
  # auth, settings, models, sessions, and browser state without data loss.
  docker run --rm --user 0:0 \
    -v "$AGENT_STATE_VOLUME_NAME:/state" \
    -v "$SESSION_STATE_VOLUME_NAME:/sessions" \
    -v "$BROWSER_STATE_VOLUME_NAME:/browser" \
    alpine:latest \
    sh -c 'set -eu; for path in /state /sessions /browser; do chown -R 1000:1000 "$path"; find "$path" -type d -exec chmod u+rwx {} +; find "$path" -type f -exec chmod u+rw {} +; done'
}

remove_workspace_volumes() {
  local volume
  local status=0

  for volume in \
    "$AGENT_STATE_VOLUME_NAME" \
    "$SESSION_STATE_VOLUME_NAME" \
    "$BROWSER_STATE_VOLUME_NAME"; do
    if state_volume_exists "$volume"; then
      if ! docker volume rm "$volume"; then
        status=1
      fi
    fi
  done

  return "$status"
}

record_state_lineage() {
  local seed

  bootstrap_seed_pointer
  seed="$(read_state_pointer "$STATE_SEED_FILE")"

  if [[ -z "$seed" ]]; then
    write_state_pointer "$STATE_SEED_FILE" "$AGENT_STATE_VOLUME_NAME"
    return 0
  fi

  if [[ "$SEED_STATE" == true ]]; then
    write_state_pointer "$STATE_SEED_FILE" "$AGENT_STATE_VOLUME_NAME"
  fi
}

repoint_seed_after_removal() {
  local seed
  local candidate

  bootstrap_seed_pointer
  seed="$(read_state_pointer "$STATE_SEED_FILE")"
  if [[ -n "$seed" ]] && state_volume_exists "$seed"; then
    return 0
  fi

  candidate="$(find_oldest_managed_state_volume)"
  if [[ -n "$candidate" ]]; then
    write_state_pointer "$STATE_SEED_FILE" "$candidate"
    printf 'pi: the previous seed was removed; seed reassigned to oldest state %s\n' "$candidate" >&2
  else
    clear_state_pointer "$STATE_SEED_FILE"
  fi
}

list_pi_stacks() (
  local temp_dir
  local ids
  local id
  local record
  local name
  local status
  local created
  local started
  local workspace
  local project
  local agent_state
  local seed
  local latest
  local marker
  local marker_text
  local inspect_format
  local delimiter=$'\037'
  local -a markers

  temp_dir="$(mktemp -d)"
  trap 'rm -rf "$temp_dir"' EXIT
  inspect_format="{{.Name}}${delimiter}{{.State.Status}}${delimiter}{{.Created}}${delimiter}{{.State.StartedAt}}${delimiter}{{index .Config.Labels \"com.pi-agents.workspace\"}}${delimiter}{{index .Config.Labels \"com.docker.compose.project\"}}${delimiter}{{range .Mounts}}{{if and (eq .Type \"volume\") (eq .Destination \"/home/node/.pi/agent\")}}{{.Name}}{{end}}{{end}}"

  ids="$(docker ps -a --filter 'label=com.pi-agents.workspace' --format '{{.ID}}')"
  if [[ -z "$ids" ]]; then
    printf 'No Pi stacks found.\n'
    return 0
  fi

  seed="$(read_state_pointer "$STATE_SEED_FILE")"
  latest="$(find_newest_managed_state_volume_for_listing)"

  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    record="$(docker inspect --format "$inspect_format" -- "$id")"
    IFS="$delimiter" read -r name status created started workspace project agent_state <<< "$record"
    name="${name#/}"
    [[ "$started" == 0001-* ]] && started="never"
    if [[ -n "$agent_state" ]] && ! state_volume_exists "$agent_state"; then
      agent_state=""
    fi
    printf '%s%s%s%s%s%s%s%s%s%s%s%s%s\n' \
      "$name" "$delimiter" "$status" "$delimiter" "$created" "$delimiter" "$started" \
      "$delimiter" "$workspace" "$delimiter" "$project" "$delimiter" "$agent_state" >> "$temp_dir/records"
  done <<< "$ids"

  while IFS="$delimiter" read -r name status created started workspace project agent_state; do
    markers=()
    [[ -n "$agent_state" && "$agent_state" == "$seed" ]] && markers+=(seed)
    [[ -n "$agent_state" && "$agent_state" == "$latest" ]] && markers+=(latest)
    marker_text=""
    for marker in "${markers[@]}"; do
      [[ -n "$marker_text" ]] && marker_text+=", "
      marker_text+="$marker"
    done
    [[ -n "$marker_text" ]] || marker_text="-"
    [[ -n "$agent_state" ]] || agent_state="none"

    printf 'STACK: %s\n  status: %s\n  workspace: %s\n  project: %s\n  created: %s\n  started: %s\n  agent-state: %s\n  markers: %s\n' \
      "$name" "$status" "$workspace" "$project" "$created" "$started" "$agent_state" "$marker_text"
  done < <(sort -t "$delimiter" -k1,1 "$temp_dir/records")
)

start_persistent_service() {
  ensure_workspace_volumes
  if [[ "$FORCE_RECREATE" == true ]]; then
    run_compose up --detach --force-recreate pi
  else
    run_compose up --detach pi
  fi
}

install_browser_extension() {
  # The extension must be registered in the mounted Pi agent state, not only
  # installed in the image: /home/node/.pi/agent is a per-workspace volume.
  run_compose exec pi pi-shell-launch pi install "$PI_BROWSER_EXTENSION_SOURCE"
}

path_component() {
  printf '%s\n' "$1" | awk -F/ -v index="$2" '{print $index}'
}

path_slug_from_index() {
  printf '%s\n' "$1" | awk -F/ -v start="$2" '{
    value = ""
    for (i = start; i <= NF; i++) {
      if ($i == "") continue
      if (value != "") value = value "-"
      value = value $i
    }
    print value
  }'
}

find_first_path_difference() {
  local index=2
  local reference
  local path
  local same

  while [[ "$index" -le 1024 ]]; do
    reference="$(path_component "$WORKSPACE" "$index")"
    if [[ -z "$reference" ]]; then
      printf '2'
      return
    fi

    same=true
    for path in "${COLLISION_PATHS[@]}"; do
      if [[ "$(path_component "$path" "$index")" != "$reference" ]]; then
        same=false
        break
      fi
    done
    if [[ "$same" == false ]]; then
      printf '%s' "$index"
      return
    fi
    ((index += 1))
  done

  printf '2'
}

is_running_status() {
  case "$1" in
    Up*|Restarting*|Paused*) return 0 ;;
    *) return 1 ;;
  esac
}

prompt_collision() {
  local index
  local status
  local has_running=false

  printf '\nWorkspace container collision detected.\n\n' >&2
  printf 'Requested workspace:\n  %s\n\n' "$WORKSPACE" >&2
  for index in "${!COLLISION_NAMES[@]}"; do
    status="${COLLISION_STATUSES[$index]}"
    printf 'Existing container:\n  %s\n  workspace: %s\n  status: %s\n\n' \
      "${COLLISION_NAMES[$index]}" "${COLLISION_PATHS[$((index + 1))]}" "$status" >&2
    if is_running_status "$status"; then
      has_running=true
    fi
  done

  if [[ "$has_running" == true ]]; then
    printf '¡¡¡ WARNING !!! Renaming/recreating the existing container may interrupt processes currently running inside it.\n\n' >&2
  fi

  printf 'Choose:\n  [r] Rename/recreate the existing container\n  [k] Keep the existing container unchanged\n  [c] Cancel\n\nChoice [c]: ' >&2
  local choice
  if ! IFS= read -r choice; then
    choice="c"
  fi
  case "$choice" in
    r|R) printf 'r' ;;
    k|K) printf 'k' ;;
    *) printf 'c' ;;
  esac
}

prepare_workspace_container() {
  local rows
  local id
  local name
  local status
  local path
  local index
  local first_difference
  local slug
  local target
  local choice
  local same_workspace_name=""
  local same_workspace_project=""
  local has_collision=false

  COLLISION_IDS=()
  COLLISION_NAMES=()
  COLLISION_STATUSES=()
  COLLISION_PATHS=("$WORKSPACE")

  rows="$(docker ps -a \
    --filter "label=com.pi-agents.workspace-basename=$WORKSPACE_BASENAME" \
    --format '{{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Label "com.pi-agents.workspace"}}')"

  while IFS=$'\t' read -r id name status path; do
    [[ -n "$id" ]] || continue
    [[ -n "$path" ]] || continue
    if [[ "$path" == "$WORKSPACE" ]]; then
      if [[ -z "$same_workspace_name" ]]; then
        same_workspace_name="$name"
        same_workspace_project="$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project" }}' "$name")"
      fi
      continue
    fi
    COLLISION_IDS+=("$id")
    COLLISION_NAMES+=("$name")
    COLLISION_STATUSES+=("$status")
    COLLISION_PATHS+=("$path")
    has_collision=true
  done <<< "$rows"

  if [[ "$has_collision" == false ]]; then
    if [[ -n "$same_workspace_name" ]]; then
      CONTAINER_NAME="$same_workspace_name"
      if [[ -n "$same_workspace_project" && "$same_workspace_project" != "$PROJECT_NAME" ]]; then
        PROJECT_NAME="$same_workspace_project"
        build_compose
      fi
    fi
    return 0
  fi

  first_difference="$(find_first_path_difference)"
  COLLISION_TARGET_NAMES=()
  for path in "${COLLISION_PATHS[@]}"; do
    slug="$(sanitize_slug "$(path_slug_from_index "$path" "$first_difference")")"
    target="pi-agents-pi-$slug"
    COLLISION_TARGET_NAMES+=("$target")
  done

  if [[ "$KEEP_EXISTING" == true ]]; then
    choice="k"
  else
    choice="$(prompt_collision)"
  fi

  case "$choice" in
    r)
      for index in "${!COLLISION_NAMES[@]}"; do
        target="${COLLISION_TARGET_NAMES[$((index + 1))]}"
        if [[ "${COLLISION_NAMES[$index]}" != "$target" ]]; then
          docker rename "${COLLISION_NAMES[$index]}" "$target"
        fi
      done
      CONTAINER_NAME="${COLLISION_TARGET_NAMES[0]}"
      PROJECT_NAME="$CONTAINER_NAME"
      build_compose
      FORCE_RECREATE=true
      ;;
    k)
      if [[ -n "$same_workspace_name" ]]; then
        CONTAINER_NAME="$same_workspace_name"
        if [[ -n "$same_workspace_project" ]]; then
          PROJECT_NAME="$same_workspace_project"
        else
          PROJECT_NAME="${COLLISION_TARGET_NAMES[0]}"
        fi
        build_compose
      else
        CONTAINER_NAME="${COLLISION_TARGET_NAMES[0]}"
        PROJECT_NAME="$CONTAINER_NAME"
        build_compose
      fi
      ;;
    *)
      printf 'pi: workspace container collision cancelled\n' >&2
      return 2
      ;;
  esac
}

list_shell_containers() {
  docker ps -a \
    --filter 'label=com.pi-agents.workspace' \
    --filter 'label=com.docker.compose.oneoff=False' \
    --format '{{.ID}}\t{{.Names}}\t{{.Status}}\t{{.State}}\t{{.Label "com.pi-agents.workspace"}}'
}

select_shell_container() {
  local rows
  local id
  local name
  local status
  local state
  local path
  local choice
  local index
  local current_index=-1
  local current_count=0
  local new_project_option=false

  SHELL_NAMES=()
  SHELL_STATUSES=()
  SHELL_STATES=()
  SHELL_PATHS=()
  rows="$(list_shell_containers)"

  while IFS=$'\t' read -r id name status state path; do
    [[ -n "$id" && -n "$name" && -n "$path" ]] || continue
    SHELL_NAMES+=("$name")
    SHELL_STATUSES+=("$status")
    SHELL_STATES+=("$state")
    SHELL_PATHS+=("$path")
    if [[ "$path" == "$WORKSPACE" ]]; then
      current_index=$((${#SHELL_NAMES[@]} - 1))
      ((current_count += 1))
    fi
  done <<< "$rows"

  if [[ "$WORKSPACE_MISSING" == true || "$current_count" -eq 0 ]]; then
    new_project_option=true
  fi

  if [[ "$new_project_option" == false && "$current_count" -eq 1 ]]; then
    SHELL_SELECTED_NAME="${SHELL_NAMES[$current_index]}"
    SHELL_SELECTED_STATUS="${SHELL_STATUSES[$current_index]}"
    SHELL_SELECTED_STATE="${SHELL_STATES[$current_index]}"
    return 0
  fi

  printf 'Choose a Pi container:\n' >&2
  if [[ "$new_project_option" == true ]]; then
    printf '0) Start a new project\n' >&2
  fi
  for index in "${!SHELL_NAMES[@]}"; do
    printf '%s) %s\n   status: %s\n   workspace: %s\n' \
      "$((index + 1))" "${SHELL_NAMES[$index]}" \
      "${SHELL_STATUSES[$index]}" "${SHELL_PATHS[$index]}" >&2
  done
  printf 'X) Press Esc to cancel\n' >&2
  printf 'Choice: ' >&2
  if ! IFS= read -r -n 1 choice; then
    printf 'pi: container selection cancelled\n' >&2
    return 2
  fi
  if [[ "$choice" =~ ^[0-9]$ ]]; then
    local remaining_choice=""
    IFS= read -r -t 0.05 -n 1024 remaining_choice <&0 || true
    choice+="$remaining_choice"
  fi

  case "$choice" in
    $'\e'|x|X)
      printf 'pi: container selection cancelled\n' >&2
      return 2
      ;;
    0)
      if [[ "$new_project_option" == true ]]; then
        SHELL_START_NEW_PROJECT=true
        return 0
      fi
      ;;
  esac

  local choice_offset=0
  if [[ "$new_project_option" == true ]]; then
    choice_offset=1
  fi
  if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice - choice_offset < 1 || choice - choice_offset > ${#SHELL_NAMES[@]} )); then
    printf 'pi: invalid container selection: %s\n' "$choice" >&2
    return 2
  fi

  index=$((choice - choice_offset - 1))
  SHELL_SELECTED_NAME="${SHELL_NAMES[$index]}"
  SHELL_SELECTED_STATUS="${SHELL_STATUSES[$index]}"
  SHELL_SELECTED_STATE="${SHELL_STATES[$index]}"
}

shell_container_is_running() {
  [[ "$1" == running ]]
}

attach_shell() {
  prepare_host_shell_rc
  select_shell_container
  if [[ "$SHELL_START_NEW_PROJECT" == true ]]; then
    mkdir -p -- "$WORKSPACE"
    WORKSPACE_MISSING=false
    prepare_workspace_container
    prepare_state_lineage
    start_persistent_service
    initialize_agent_state
    repair_state_permissions
    install_browser_extension
    record_state_lineage
    SHELL_SELECTED_NAME="$CONTAINER_NAME"
    SHELL_SELECTED_STATE=running
  fi

  if ! shell_container_is_running "$SHELL_SELECTED_STATE"; then
    docker start "$SHELL_SELECTED_NAME" >/dev/null
  fi

  if [[ "$SHELL_AS_ROOT" == true ]]; then
    docker exec -it --user 0 "$SHELL_SELECTED_NAME" pi-shell-launch
  else
    docker exec -it "$SHELL_SELECTED_NAME" pi-shell-launch
  fi
}

list_copy_containers() {
  docker ps -a \
    --filter 'label=com.pi-agents.workspace' \
    --filter 'label=com.docker.compose.oneoff=False' \
    --format '{{.ID}}\t{{.Names}}\t{{.Status}}\t{{.State}}\t{{.Label "com.pi-agents.workspace"}}'
}

copy_container_volume() {
  docker inspect --format '{{range .Mounts}}{{if eq .Destination "/home/node/.pi/agent"}}{{.Name}}{{end}}{{end}}' "$1"
}

select_copy_container() {
  local role="$1" exclude_name="${2:-}" rows id name status state path choice index=0
  local -a names=() statuses=() states=() paths=() volumes=()

  while IFS=$'\t' read -r id name status state path; do
    [[ -n "$id" && -n "$name" && -n "$path" ]] || continue
    [[ "$name" == "$exclude_name" ]] && continue
    volume="$(copy_container_volume "$name")"
    [[ -n "$volume" ]] || continue
    names+=("$name")
    statuses+=("$status")
    states+=("$state")
    paths+=("$path")
    volumes+=("$volume")
  done < <(list_copy_containers)

  ((${#names[@]} > 0)) || { printf 'pi: no usable Pi containers available for %s\n' "$role" >&2; return 2; }
  printf 'Choose a %s Pi container:\n' "$role" >&2
  for index in "${!names[@]}"; do
    printf '%s) %s\n   status: %s\n   workspace: %s\n   agent-state: %s\n' \
      "$((index + 1))" "${names[$index]}" "${statuses[$index]}" "${paths[$index]}" "${volumes[$index]}" >&2
  done
  printf 'X) Press Esc to cancel\nChoice: ' >&2
  IFS= read -r -n 1 choice || return 2
  local trailing_choice=''
  IFS= read -r -t 0.05 -n 1024 trailing_choice <&0 || true
  choice+="$trailing_choice"
  printf '\n' >&2
  case "$choice" in
    $'\e'|x|X) printf 'pi: container selection cancelled\n' >&2; return 2 ;;
  esac
  [[ "$choice" =~ ^[0-9]+$ ]] || { printf 'pi: invalid container selection: %s\n' "$choice" >&2; return 2; }
  index=$((choice - 1))
  (( index >= 0 && index < ${#names[@]} )) || { printf 'pi: invalid container selection: %s\n' "$choice" >&2; return 2; }

  COPY_SELECTED_NAME="${names[$index]}"
  COPY_SELECTED_VOLUME="${volumes[$index]}"
  COPY_SELECTED_STATE="${states[$index]}"
  COPY_SELECTED_PATH="${paths[$index]}"
}

current_copy_container() {
  local id name status state path volume
  while IFS=$'\t' read -r id name status state path; do
    [[ -n "$id" && "$path" == "$WORKSPACE" ]] || continue
    volume="$(copy_container_volume "$name")"
    [[ -n "$volume" ]] || continue
    COPY_CURRENT_NAME="$name"
    COPY_CURRENT_VOLUME="$volume"
    COPY_CURRENT_STATE="$state"
    return 0
  done < <(list_copy_containers)
  COPY_CURRENT_NAME=''
  COPY_CURRENT_VOLUME="$AGENT_STATE_VOLUME_NAME"
  COPY_CURRENT_STATE='unknown'
  docker volume inspect "$COPY_CURRENT_VOLUME" >/dev/null 2>&1
}

copy_agent_state() {
  local source_volume target_volume source_name target_name
  current_copy_container || { printf 'pi: current workspace has no usable agent-state volume\n' >&2; return 2; }

  if [[ "$COPY_FROM" == true && "$COPY_TO" == true ]]; then
    select_copy_container source || return $?
    source_volume="$COPY_SELECTED_VOLUME"
    source_name="$COPY_SELECTED_NAME"
    select_copy_container destination "$source_name" || return $?
    target_volume="$COPY_SELECTED_VOLUME"
    target_name="$COPY_SELECTED_NAME"
    target_state="$COPY_SELECTED_STATE"
  elif [[ "$COPY_TO" == true ]]; then
    source_volume="$COPY_CURRENT_VOLUME"
    source_name="$COPY_CURRENT_NAME"
    select_copy_container destination "$source_name" || return $?
    target_volume="$COPY_SELECTED_VOLUME"
    target_name="$COPY_SELECTED_NAME"
    target_state="$COPY_SELECTED_STATE"
  else
    target_volume="$COPY_CURRENT_VOLUME"
    target_name="$COPY_CURRENT_NAME"
    target_state="$COPY_CURRENT_STATE"
    select_copy_container source "$target_name" || return $?
    source_volume="$COPY_SELECTED_VOLUME"
    source_name="$COPY_SELECTED_NAME"
  fi

  [[ "$source_volume" != "$target_volume" ]] || { printf 'pi: source and destination are the same state volume\n' >&2; return 2; }
  if [[ "$target_state" == running ]]; then
    printf 'pi: destination is running; copied auth/extensions may require a Pi reload or restart\n' >&2
  fi

  copy_args=(--source /state-source --target /state-target)
  [[ "$COPY_SESSIONS" == true ]] && copy_args+=(--sessions)
  [[ "$COPY_AUTH" == true ]] && copy_args+=(--auth)
  [[ "$COPY_EXTENSIONS" == true ]] && copy_args+=(--extensions)
  [[ "$COPY_ALL" == true ]] && copy_args+=(--all)
  [[ "$COPY_OVERRIDE" == true ]] && copy_args+=(--override)

  printf 'pi: copying agent state from %s to %s\n' "$source_name" "$target_name" >&2

  copy_image="$(run_compose images -q pi 2>/dev/null | tail -n 1)"
  [[ -n "$copy_image" ]] || copy_image="${PROJECT_NAME}-pi"
  copy_tty_args=(-i)
  [[ -t 0 ]] && copy_tty_args+=(-t)
  docker run --rm "${copy_tty_args[@]}" --user 0 \
    -v "$STACK_ROOT/bin/pi-state-copy:/usr/local/bin/pi-state-copy:ro" \
    -v "$source_volume:/state-source:ro" \
    -v "$target_volume:/state-target" \
    "$copy_image" bash /usr/local/bin/pi-state-copy "${copy_args[@]}"
  printf 'pi: agent-state copy complete\n' >&2
  docker run --rm --user 0 -v "$target_volume:/state" alpine:latest \
    sh -c 'set -eu; chown -R 1000:1000 /state; find /state -type d -exec chmod u+rwx {} +; find /state -type f -exec chmod u+rw {} +'
}

if [[ "$COPY_COMMAND" == true ]]; then
  copy_agent_state
  exit $?
fi

if [[ "$LIST_COMMAND" == true ]]; then
  list_pi_stacks
  exit $?
fi

if [[ "$SHELL_COMMAND" == true ]]; then
  attach_shell
  exit $?
fi

if [[ "$PI_PASSTHROUGH_MARKER" == false && "${1:-}" == "remove" ]]; then
  if [[ "$REMOVE_AFTER_RUN" == true ]]; then
    printf 'pi: --rm cannot be combined with remove; remove targets the persistent service\n' >&2
    exit 2
  fi
  if [[ "$REPLACE_CONTAINER" == true || "$KEEP_EXISTING" == true || "$NEW_STATE" == true || "$SEED_STATE" == true || "$LATEST_STATE" == true ]]; then
    printf 'pi: --replace, --keep-existing, --new-state, --seed, and --latest-state cannot be combined with remove\n' >&2
    exit 2
  fi

  shift
  REMOVE_VOLUMES=false
  for arg in "$@"; do
    case "$arg" in
      --all)
        REMOVE_VOLUMES=true
        ;;
      *)
        printf 'pi: unsupported remove option: %s\n' "$arg" >&2
        printf 'usage: pi remove [--all]\n' >&2
        exit 2
        ;;
    esac
  done

  # Reuse the workspace collision resolver without prompting or renaming.
  ORIGINAL_KEEP_EXISTING="$KEEP_EXISTING"
  KEEP_EXISTING=true
  prepare_workspace_container
  KEEP_EXISTING="$ORIGINAL_KEEP_EXISTING"

  if [[ "$REMOVE_VOLUMES" == true ]]; then
    run_compose down
    removal_status=0
    if ! remove_workspace_volumes; then
      removal_status=1
    fi
    repoint_seed_after_removal
    if [[ "$removal_status" -ne 0 ]]; then
      exit "$removal_status"
    fi
  else
    run_compose down
  fi
  exit $?
fi

if [[ "$PI_PASSTHROUGH_MARKER" == false && "${1:-}" == "stop" ]]; then
  run_compose stop
  exit $?
fi

if [[ "$PI_PASSTHROUGH_MARKER" == false && "${1:-}" == "update" ]]; then
  if [[ "$REMOVE_AFTER_RUN" == true ]]; then
    printf 'pi: --rm cannot be combined with update; updates require the persistent service\n' >&2
    exit 2
  fi

  shift
  UPDATE_ARGS=()
  for arg in "$@"; do
    case "$arg" in
      --extensions|--models)
        UPDATE_ARGS+=("$arg")
        ;;
      *)
        printf 'pi: unsupported update option: %s\n' "$arg" >&2
        printf 'usage: pi update [--extensions] [--models]\n' >&2
        exit 2
        ;;
    esac
  done

  prepare_host_shell_rc
  prepare_workspace_container
  prepare_state_lineage
  if [[ "${#UPDATE_ARGS[@]}" -eq 0 ]]; then
    run_compose build --pull --no-cache pi
    FORCE_RECREATE=true
    start_persistent_service
    initialize_agent_state
    repair_state_permissions
    install_browser_extension
    record_state_lineage
    exit $?
  fi

  start_persistent_service
  initialize_agent_state
  repair_state_permissions
  install_browser_extension
  record_state_lineage
  run_logged_pi() {
    run_compose exec pi pi-shell-launch pi-session-log "$@"
  }
  run_logged_pi update "${UPDATE_ARGS[@]}"
  exit $?
fi

if [[ "$REMOVE_AFTER_RUN" == true ]]; then
  prepare_host_shell_rc
  prepare_state_lineage
  ensure_workspace_volumes
  initialize_agent_state
  repair_state_permissions
  run_compose run --rm pi pi-shell-launch pi install "$PI_BROWSER_EXTENSION_SOURCE"
  run_compose run --rm --service-ports pi pi-shell-launch pi "$@"
  exit $?
fi

prepare_host_shell_rc
prepare_workspace_container
prepare_state_lineage

# `docker compose logs` only captures the service's main process streams.
# The persistent service starts pi-session-forwarder alongside sleep, while
# this helper only preserves Pi's foreground interactive PTY via compose exec.
run_logged_pi() {
  run_compose exec pi pi-shell-launch pi-session-log "$@"
}

start_persistent_service
initialize_agent_state
repair_state_permissions
install_browser_extension
record_state_lineage
run_logged_pi "$@"
