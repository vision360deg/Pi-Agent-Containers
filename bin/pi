#!/usr/bin/env bash
set -euo pipefail

if (( BASH_VERSINFO[0] < 4 )); then
  printf 'pi: Bash 4 or newer is required on PATH\n' >&2
  exit 2
fi

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIRECTORY="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
  SOURCE="$(readlink -- "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIRECTORY/$SOURCE"
done

ROOT="$(cd -P -- "$(dirname -- "$SOURCE")/.." && pwd)"
INVOCATION_DIRECTORY="$PWD"

FORCE_BASH=false
FORCE_ZSH=false
NO_RC_CONFIG=0
HOST_SHELL_NAME=""
TEMPORARY_DIRECTORIES=()

cleanup_temporary_files() {
  local directory
  for directory in "${TEMPORARY_DIRECTORIES[@]}"; do
    [[ ! -e "$directory" ]] || rm -rf -- "$directory"
  done
}
trap cleanup_temporary_files EXIT

select_host_shell() {
  if [[ "$FORCE_BASH" == true && "$FORCE_ZSH" == true ]]; then
    printf 'pi: --bash and --zsh are mutually exclusive\n' >&2
    return 2
  fi
  if [[ "$FORCE_BASH" == true ]]; then
    HOST_SHELL_NAME=bash
  elif [[ "$FORCE_ZSH" == true ]]; then
    HOST_SHELL_NAME=zsh
  else
    HOST_SHELL_NAME="${SHELL:-/bin/bash}"
    HOST_SHELL_NAME="${HOST_SHELL_NAME##*/}"
  fi
  case "$HOST_SHELL_NAME" in
    bash|zsh) ;;
    *)
      printf 'pi: unsupported host shell: %s (supported: bash, zsh)\n' "$HOST_SHELL_NAME" >&2
      return 2
      ;;
  esac
}

# Only flows that start a host-shell session need a supported shell.
prepare_host_shell_rc() {
  select_host_shell || return
  [[ "$NO_RC_CONFIG" -eq 0 ]] || return 0
  mkdir -p -- "$HOST_SHELL_RC_SOURCE"
  chmod 0755 "$HOST_SHELL_RC_SOURCE"
  "$ROOT/bin/pi-shell-rc" \
    --shell "$HOST_SHELL_NAME" \
    --home "$HOME" \
    --output "$HOST_SHELL_RC_FILE"
}

fail() {
  printf 'pi: %s\n' "$*" >&2
  exit 2
}

print_detailed_help() {
  cat <<'EOF'
Containerized Pi wrapper

Usage:
  pi [-h|--help]
  pi [--workspace PATH] [--bash|--zsh] [--no-rc-config] [--rebuild] [--oauth [PORTS...]]
     [--replace|--keep-existing] [--new-state|[--seed] [--latest-state]] [PI_ARGS...]
  pi [--workspace PATH] [--bash|--zsh] [--no-rc-config] [--rebuild] [--oauth [PORTS...]]
     --rm [PI_ARGS...]
  pi [--workspace PATH] --host [PI_ARGS...]
  pi [--workspace PATH] stop
  pi [--workspace PATH] update [--extensions] [--models]
  pi list
  pi [--workspace PATH] remove [--all]
  pi [--workspace PATH] shell [--root|-r]
  pi [--workspace PATH] copy [--from|--to] [-s|--sessions] [-a|--auth] [-e|--extensions]
     [--all] [--override]
  pi [--workspace PATH] - PI_ARGS...

Options:
  -h, --help          Show this help without starting Docker.
  --workspace PATH    Use PATH as the workspace instead of the invocation directory;
                      it overrides PI_WORKSPACE. Relative paths resolve from the
                      invocation directory. --workspace=PATH also works.
  --rm                Run Pi in a disposable container instead of the persistent
                      service; the workspace state volumes are still used.
  --host              Run native Pi on the host from the workspace, without Docker.
                      Pi's installer launcher ${PI_CODING_AGENT_DIR:-~/.pi/agent}/bin/pi
                      is preferred, then the first pi on PATH that is not this
                      wrapper. If neither exists, offer to run
                      curl -fsSL https://pi.dev/install.sh | sh. All remaining
                      arguments, including wrapper command names, go to native Pi,
                      which uses the host's ~/.pi/agent state, not workspace volumes.
  --replace           Force-recreate the persistent workspace container.
  --rebuild           Build the image with the Docker build cache before this launch;
                      Compose recreates the service from it. Without it, existing
                      images are reused and a missing image is built.
  --keep-existing     When another workspace has the same basename, keep its
                      container unchanged and give this workspace a disambiguated name.
  --new-state         Run on this workspace's extra agent-state volume, created empty
                      and never seeded, and recreate the container onto it. It never
                      becomes the seed or the latest state, and the normal agent-state
                      volume is untouched; omit the flag later to switch back.
                      Launches warn while the extra volume exists.
  --seed              Promote this workspace's agent state to the seed that new
                      workspaces copy. The pointer is ~/.config/pi-agent-containers/seed;
                      PI_AGENT_CONTAINERS_CONFIG_PATH overrides its directory.
  --latest-state      On first initialization, copy the newest managed state volume
                      instead of the seed. Once the workspace has state, it only warns.
  --bash, --zsh       Use Bash or zsh for Pi and shell processes instead of the
                      basename of the host SHELL value.
  --no-rc-config      Start the selected shell without the generated host startup
                      configuration.
  --oauth [PORTS...]  Publish loopback ports for browser OAuth callbacks: 1455
                      (OpenAI Codex), 53692 (Anthropic), and 51121 (pi-antigravity),
                      plus comma- or space-separated PORTS and PI_OAUTH_CALLBACK_PORTS.
                      A port something else listens on is refused; ports this
                      workspace's running stack publishes are reused, but a --rm run
                      cannot share them.

Commands:
  stop                Stop the current workspace's stack; containers, networks, and
                      volumes are kept. Fails when the workspace has no stack.
  update              Rebuild the image with a fresh pull and no build cache, then
                      force-recreate the persistent service.
  update --extensions Start the persistent service and run Pi's extension update.
  update --models     Start the persistent service and update Pi's model catalogs.
                      The two flags can be combined.
  list                List running and stopped persistent Pi stacks with workspace,
                      project, created and started times, agent-state volumes, and
                      seed/latest markers, then state volumes left without a stack.
                      It does not change Docker state.
  remove [--all]      Remove the current workspace's stack. State volumes are kept,
                      and a warning names a kept extra state volume. --all also
                      removes them; host workspace files are never removed. When the
                      seed is removed, the oldest remaining managed state becomes the
                      seed, or the pointer is cleared. Without a stack, remove fails,
                      and remove --all lists the leftover state volumes and asks
                      whether to leave them (default), delete all, or delete some.
  shell [--root|-r]   Open the selected Bash or zsh in the current workspace's Pi
                      container, starting it when stopped. A current stack without
                      the generated rc mount is first reconciled with Compose up. If
                      no container matches the workspace, a picker lists all
                      persistent Pi containers plus `0) Start a new project` and
                      `X) Cancel (or Esc)`. --root opens the shell as user 0
                      (root) instead of the image's node user.
  copy                Copy agent state between Pi workspace state volumes through a
                      disposable helper container; neither workspace needs a container.
                      The current workspace is the destination and a picker of the
                      other managed state volumes selects the source (--from); --to
                      reverses that. Without -s/--sessions, -a/--auth, or
                      -e/--extensions, sessions, provider auth, and extensions are
                      all copied. --all skips the item pickers. Copies are additive;
                      duplicates prompt r=replace, s=skip, a=replace all, q=cancel,
                      and --override replaces them. Items are staged, then published;
                      a failed publish restores the earlier items. Cancelling leaves
                      the destination unchanged and exits with status 3. Symlinked
                      state paths and overlapping source/destination are refused.
                      A warning names each running container that mounts the
                      destination state; restart it to pick up copied auth or extensions.

  In the shell and copy pickers a choice is a single key; with ten or more
  entries, a choice starting with 1-9 is a number confirmed with Enter. Each
  picker ends with `X) Cancel (or Esc)`.

Examples:
  pi                               # Start or reuse this workspace's container.
  pi "Inspect this project"        # Start Pi with an initial prompt.
  pi --workspace ~/src/project     # Use an explicit workspace.
  pi --rm                          # Run Pi in a disposable container.
  pi --host update                 # Update the native Pi installation.
  pi --oauth 7000,7001             # Also publish two custom callback ports.
  pi update --extensions           # Update Pi-managed extensions.
  pi shell --root                  # Open a root shell in this workspace's container.
  pi copy --auth --override        # Copy provider auth, replacing duplicates.
  pi install npm:pi-web-access     # Pi's install command: add a package.
  pi - update                      # Pi's update command, run in the container.

Restrictions:
  --bash and --zsh are mutually exclusive.
  --replace and --keep-existing are mutually exclusive.
  --new-state cannot be combined with --seed or --latest-state.
  --rm cannot be combined with stop, update, remove, list, shell, copy, --replace,
  --keep-existing, --seed, or --latest-state.
  --rebuild cannot be combined with stop, update, remove, list, or copy; with
  shell it can only rebuild the current workspace's image.
  --replace, --keep-existing, --new-state, --seed, --latest-state, and --oauth
  cannot be combined with stop, remove, list, shell, or copy.
  --host accepts only --workspace among wrapper options; container, state, shell,
  and OAuth options are rejected. Wrapper commands are not interpreted after --host.
  list accepts no arguments, rejects --workspace, and does not change Docker state.
  remove accepts only --all, update only --extensions and --models, shell only
  -r/--root, and copy only its listed options; --from and --to are mutually exclusive.
  A basename collision with another workspace prompts for action and defaults to cancel.

Passthrough and help:
  Arguments that are not wrapper options or commands go to Pi; a leading `-` sends
  everything after it to Pi, even a wrapper command name (`pi - update`).
  Exact `pi -h` or `pi --help` shows this help; a help flag with other arguments
  shows the brief usage; `pi --host - --help` shows native Pi's help.
EOF
}

print_brief_usage() {
  cat <<'EOF'
Usage:
  pi [-h|--help]
  pi [--workspace PATH] [--bash|--zsh] [--no-rc-config] [--rebuild] [--oauth [PORTS...]]
     [--replace|--keep-existing] [--new-state|[--seed] [--latest-state]] [PI_ARGS...]
  pi [--workspace PATH] [--bash|--zsh] [--no-rc-config] [--rebuild] [--oauth [PORTS...]]
     --rm [PI_ARGS...]
  pi [--workspace PATH] --host [PI_ARGS...]
  pi [--workspace PATH] stop
  pi [--workspace PATH] update [--extensions] [--models]
  pi list
  pi [--workspace PATH] remove [--all]
  pi [--workspace PATH] shell [--root|-r]
  pi [--workspace PATH] copy [--from|--to] [-s|--sessions] [-a|--auth] [-e|--extensions]
     [--all] [--override]
  pi [--workspace PATH] - PI_ARGS...

Commands:
  stop              Stop the current workspace's persistent stack.
  update            Rebuild the image, or update Pi extensions and model catalogs.
  list              List persistent Pi stacks without changing Docker state.
  remove [--all]    Remove the current stack; --all also removes its state volumes.
  shell [--root|-r] Open a shell in the current or selected Pi container.
  copy              Copy agent state between Pi workspaces.

Run `pi --help` for detailed usage.
EOF
}

ORIGINAL_ARGUMENT_COUNT=$#
HELP_REQUESTED=false
HELP_SCAN_PASSTHROUGH=false
for arg in "$@"; do
  if [[ "$HELP_SCAN_PASSTHROUGH" == true ]]; then
    continue
  fi
  if [[ "$arg" == "-" ]]; then
    HELP_SCAN_PASSTHROUGH=true
    continue
  fi
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    HELP_REQUESTED=true
    break
  fi
done
if [[ "$HELP_REQUESTED" == true ]]; then
  if [[ "$ORIGINAL_ARGUMENT_COUNT" -eq 1 ]]; then
    print_detailed_help
  else
    print_brief_usage
  fi
  exit 0
fi

REMOVE_AFTER_RUN=false
RUN_ON_HOST=false
REPLACE_CONTAINER=false
REBUILD_IMAGE=false
KEEP_EXISTING=false
NEW_STATE=false
SEED_STATE=false
LATEST_STATE=false
OAUTH_CALLBACK=false
WORKSPACE_OPTION=false
PASSTHROUGH_MARKER=false
COMMAND=run
SHELL_AS_ROOT=false
SHELL_START_NEW_PROJECT=false
REMOVE_VOLUMES=false
COPY_FROM=false
COPY_TO=false
COPY_SESSIONS=false
COPY_AUTH=false
COPY_EXTENSIONS=false
COPY_ALL=false
COPY_OVERRIDE=false
UPDATE_ARGS=()
WORKSPACE="${PI_WORKSPACE:-$INVOCATION_DIRECTORY}"
WORKSPACE_MISSING=false
OAUTH_CALLBACK_PORTS=(1455 53692 51121)
OAUTH_EXTRA_PORTS=()
OAUTH_OVERRIDE_FILE=""
PI_BROWSER_EXTENSION_SOURCE="npm:pi-agent-browser-native"
PI_NATIVE_INSTALLER_URL="https://pi.dev/install.sh"

oauth_port_is_known() {
  [[ "$1" == 1455 || "$1" == 53692 || "$1" == 51121 ]]
}

oauth_append_port() {
  local raw_port="$1"
  local source="$2"
  local port
  local existing

  if ! [[ "$raw_port" =~ ^[0-9]+$ ]]; then
    fail "invalid OAuth callback port in $source: $raw_port"
  fi

  port=$((10#$raw_port))
  if (( port < 1 || port > 65535 )); then
    fail "OAuth callback port must be between 1 and 65535 in $source: $raw_port"
  fi

  for existing in "${OAUTH_CALLBACK_PORTS[@]}"; do
    if [[ "$existing" == "$port" ]]; then
      return 0
    fi
  done

  OAUTH_CALLBACK_PORTS+=("$port")
  if ! oauth_port_is_known "$port"; then
    OAUTH_EXTRA_PORTS+=("$port")
  fi
}

oauth_parse_port_list() {
  local list="$1"
  local source="$2"
  local normalized
  local token
  local -a tokens=()

  normalized="${list//$'\n'/ }"
  normalized="${normalized//,/ }"
  if [[ -z "${normalized//[[:space:]]/}" ]]; then
    return 0
  fi

  read -r -a tokens <<< "$normalized"
  for token in "${tokens[@]}"; do
    oauth_append_port "$token" "$source"
  done
}

oauth_cli_token_is_port_list() {
  [[ "$1" =~ ^[0-9]+(,[0-9]+)*,?$ ]]
}

create_oauth_override() {
  local override_directory port

  [[ "$OAUTH_CALLBACK" == true ]] || return 0
  oauth_parse_port_list "${PI_OAUTH_CALLBACK_PORTS:-}" 'PI_OAUTH_CALLBACK_PORTS'
  [[ "${#OAUTH_EXTRA_PORTS[@]}" -gt 0 ]] || return 0
  override_directory="$(mktemp -d "${TMPDIR:-/tmp}/pi-oauth.XXXXXX")"
  TEMPORARY_DIRECTORIES+=("$override_directory")
  OAUTH_OVERRIDE_FILE="$override_directory/compose.oauth.yml"
  {
    printf 'services:\n'
    printf '  pi:\n'
    printf '    ports:\n'
    for port in "${OAUTH_EXTRA_PORTS[@]}"; do
      printf '      - "127.0.0.1:%s:%s"\n' "$port" "$port"
      printf '      - "[::1]:%s:%s"\n' "$port" "$port"
    done
  } > "$OAUTH_OVERRIDE_FILE"
}

# Whether nothing on the host listens on a TCP port: lsof first, then nc.
oauth_port_is_available() {
  local port="$1"
  if command -v lsof >/dev/null 2>&1; then
    ! lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
    return
  fi
  if command -v nc >/dev/null 2>&1; then
    ! nc -z 127.0.0.1 "$port" >/dev/null 2>&1 && ! nc -z ::1 "$port" >/dev/null 2>&1
    return
  fi
  fail 'cannot check OAuth callback ports: install lsof or nc'
}

# Refuses OAuth callback ports that something already listens on. Ports this
# workspace's own stack already publishes stay usable, so a repeated `pi --oauth`
# reuses them; a disposable --rm run cannot share them.
validate_oauth_ports() {
  local port owned=$'\n'
  [[ "$OAUTH_CALLBACK" == true ]] || return 0
  if [[ "$REMOVE_AFTER_RUN" != true ]] && docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
    owned+="$(docker inspect --format '{{range $port, $bindings := .NetworkSettings.Ports}}{{range $bindings}}{{printf "%s:%s:%s\n" .HostIp .HostPort $port}}{{end}}{{end}}' "$CONTAINER_NAME")" ||
      fail 'could not inspect the OAuth callback ports of this workspace stack'
    owned+=$'\n'
  fi
  for port in "${OAUTH_CALLBACK_PORTS[@]}"; do
    [[ "$owned" != *$'\n'"127.0.0.1:$port:$port/tcp"$'\n'* && "$owned" != *$'\n'"::1:$port:$port/tcp"$'\n'* ]] || continue
    oauth_port_is_available "$port" || fail "OAuth callback port is already in use: $port"
  done
}

# These are wrapper options, so consume them before passing the remaining
# arguments to Pi. Help invocations exit before this point, so even
# `pi --workspace --help` remains a local brief-help request.
while [[ $# -gt 0 ]]; do
  case "$1" in
    --rm)
      REMOVE_AFTER_RUN=true
      shift
      ;;
    --host)
      RUN_ON_HOST=true
      shift
      ;;
    --replace)
      REPLACE_CONTAINER=true
      shift
      ;;
    --rebuild)
      REBUILD_IMAGE=true
      shift
      ;;
    --keep-existing)
      KEEP_EXISTING=true
      shift
      ;;
    --new-state)
      NEW_STATE=true
      shift
      ;;
    --seed)
      SEED_STATE=true
      shift
      ;;
    --latest-state)
      LATEST_STATE=true
      shift
      ;;
    --bash)
      FORCE_BASH=true
      shift
      ;;
    --zsh)
      FORCE_ZSH=true
      shift
      ;;
    --no-rc-config)
      NO_RC_CONFIG=1
      shift
      ;;
    --oauth)
      OAUTH_CALLBACK=true
      shift
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --*)
            break
            ;;
          *,*|[0-9]*)
            oauth_cli_token_is_port_list "$1" || fail "invalid OAuth callback port list: $1"
            oauth_parse_port_list "$1" '--oauth'
            shift
            ;;
          *)
            break
            ;;
        esac
      done
      ;;
    --oauth=*)
      OAUTH_CALLBACK=true
      oauth_value="${1#--oauth=}"
      if [[ -n "$oauth_value" ]]; then
        oauth_cli_token_is_port_list "$oauth_value" || fail "invalid OAuth callback port list: $oauth_value"
        oauth_parse_port_list "$oauth_value" '--oauth'
      fi
      shift
      ;;
    --workspace)
      if [[ "$#" -lt 2 ]]; then
        printf 'pi: --workspace requires a path\n' >&2
        fail 'usage: pi [--workspace PATH] [PI_ARGS...]'
      fi
      WORKSPACE="$2"
      WORKSPACE_OPTION=true
      shift 2
      ;;
    --workspace=*)
      WORKSPACE="${1#--workspace=}"
      if [[ -z "$WORKSPACE" ]]; then
        printf 'pi: --workspace requires a path\n' >&2
        fail 'usage: pi [--workspace PATH] [PI_ARGS...]'
      fi
      WORKSPACE_OPTION=true
      shift
      ;;
    *)
      break
      ;;
  esac
done

# Native Pi for --host: the official installer's launcher script, otherwise the
# first pi on PATH that is not this wrapper under any name.
find_native_pi() {
  local agent_dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
  local candidate

  while IFS= read -r candidate; do
    [[ -f "$candidate" && -x "$candidate" ]] || continue
    [[ "$candidate" -ef "$SOURCE" ]] && continue
    [[ "$candidate" == /* ]] || candidate="$PWD/$candidate"
    printf '%s\n' "$candidate"
    return 0
  done < <(printf '%s\n' "${agent_dir%/}/bin/pi"; type -aP pi)
  return 1
}

# The official installer refuses to install while pi resolves to a program it
# does not manage, such as this wrapper, so the wrapper is hidden from it. The
# launcher directory goes first so the installer keeps its launcher there
# instead of linking pi into a shared PATH directory that would shadow this
# wrapper or offering to edit shell profiles.
native_pi_installer_path() {
  local agent_dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
  local installer_path="${agent_dir%/}/bin"
  local entry
  local -a entries=()

  IFS=: read -r -a entries <<< "$PATH"
  for entry in "${entries[@]}"; do
    [[ "${entry:-.}/pi" -ef "$SOURCE" ]] && continue
    installer_path+=":$entry"
  done
  printf '%s\n' "$installer_path"
}

offer_native_pi_install() {
  local answer=""
  local installer_path
  local native_pi
  local status=0

  printf 'pi: native Pi was not found.\n' >&2
  printf 'pi: run the official installer (curl -fsSL %s | sh)? [y/N] ' "$PI_NATIVE_INSTALLER_URL" >&2
  IFS= read -r answer || true
  if [[ "$answer" != y && "$answer" != Y ]]; then
    printf 'pi: native Pi was not installed; install it with: curl -fsSL %s | sh\n' "$PI_NATIVE_INSTALLER_URL" >&2
    exit 127
  fi

  installer_path="$(native_pi_installer_path)"
  (
    cd -P -- "$WORKSPACE" &&
      curl -fsSL "$PI_NATIVE_INSTALLER_URL" | PATH="$installer_path" sh
  ) || status=$?

  # The installer offers to start Pi itself, so never start it a second time.
  if native_pi="$(find_native_pi)"; then
    printf 'pi: native Pi is ready at %s; start it with: pi --host\n' "$native_pi" >&2
    printf 'pi: update native Pi with: pi --host update\n' >&2
    exit "$status"
  fi
  printf 'pi: native Pi is still not installed\n' >&2
  if [[ "$status" -eq 0 ]]; then
    status=127
  fi
  exit "$status"
}

# Native host runs never touch Docker, so every remaining argument, including
# wrapper command names, belongs to native Pi.
if [[ "$RUN_ON_HOST" == true ]]; then
  if [[ "$REMOVE_AFTER_RUN" == true || "$REPLACE_CONTAINER" == true || "$REBUILD_IMAGE" == true ||
    "$KEEP_EXISTING" == true || "$NEW_STATE" == true || "$SEED_STATE" == true ||
    "$LATEST_STATE" == true || "$OAUTH_CALLBACK" == true || "$FORCE_BASH" == true ||
    "$FORCE_ZSH" == true || "$NO_RC_CONFIG" -eq 1 ]]; then
    printf 'pi: --host cannot be combined with container, state, shell, or OAuth options\n' >&2
    fail 'usage: pi [--workspace PATH] --host [PI_ARGS...]'
  fi
  if [[ "${1:-}" == "-" ]]; then
    shift
  fi
  if [[ ! -d "$WORKSPACE" ]]; then
    printf 'pi: workspace does not exist: %s\n' "$WORKSPACE" >&2
    exit 1
  fi
  NATIVE_PI="$(find_native_pi)" || offer_native_pi_install
  cd -P -- "$WORKSPACE"
  exec "$NATIVE_PI" "$@"
fi

if [[ "${1:-}" == "-" ]]; then
  PASSTHROUGH_MARKER=true
  shift
  if [[ $# -eq 0 ]]; then
    printf 'pi: - requires a Pi argument\n' >&2
    fail 'usage: pi - PI_ARGS...'
  fi
fi

if [[ "$PASSTHROUGH_MARKER" == false && $# -gt 0 ]]; then
  case "$1" in
    stop|update|list|remove|shell|copy)
      COMMAND="$1"
      shift
      ;;
  esac
fi

case "$COMMAND" in
  stop|list)
    [[ $# -eq 0 ]] || fail "usage: pi $COMMAND"
    ;;
  remove)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --all) REMOVE_VOLUMES=true; shift ;;
        *)
          printf 'pi: unsupported remove option: %s\n' "$1" >&2
          fail 'usage: pi remove [--all]'
          ;;
      esac
    done
    ;;
  shell)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -r|--root) SHELL_AS_ROOT=true; shift ;;
        *)
          printf 'pi: unsupported shell option: %s\n' "$1" >&2
          fail 'usage: pi shell [--root|-r]'
          ;;
      esac
    done
    ;;
  update)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --extensions|--models) UPDATE_ARGS+=("$1"); shift ;;
        *)
          printf 'pi: unsupported update option: %s\n' "$1" >&2
          fail 'usage: pi update [--extensions] [--models]'
          ;;
      esac
    done
    ;;
  copy)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --from) COPY_FROM=true; shift ;;
        --to) COPY_TO=true; shift ;;
        -s|--sessions) COPY_SESSIONS=true; shift ;;
        -a|--auth) COPY_AUTH=true; shift ;;
        -e|--extensions) COPY_EXTENSIONS=true; shift ;;
        --all) COPY_ALL=true; shift ;;
        --override) COPY_OVERRIDE=true; shift ;;
        *)
          printf 'pi: unsupported copy option: %s\n' "$1" >&2
          fail 'usage: pi copy [--from] [--to] [-s|--sessions] [-a|--auth] [-e|--extensions] [--all] [--override]'
          ;;
      esac
    done
    ;;
esac

# Option and command combinations are refused before the workspace is
# resolved, so a conflicting invocation fails the same way everywhere.
[[ ! ( "$FORCE_BASH" == true && "$FORCE_ZSH" == true ) ]] || fail '--bash and --zsh are mutually exclusive'
[[ ! ( "$REPLACE_CONTAINER" == true && "$KEEP_EXISTING" == true ) ]] || fail '--replace and --keep-existing are mutually exclusive'
[[ ! ( "$SEED_STATE" == true && "$NEW_STATE" == true ) ]] ||
  fail '--new-state and --seed are mutually exclusive; the extra state volume is never a seed'
[[ ! ( "$LATEST_STATE" == true && "$NEW_STATE" == true ) ]] ||
  fail '--new-state and --latest-state are mutually exclusive; the extra state volume is never seeded'
[[ ! ( "$COPY_FROM" == true && "$COPY_TO" == true ) ]] || fail '--from and --to are mutually exclusive'
if [[ "$REMOVE_AFTER_RUN" == true ]]; then
  [[ "$REPLACE_CONTAINER" != true ]] || fail '--rm cannot be combined with --replace'
  [[ "$KEEP_EXISTING" != true ]] || fail '--rm cannot be combined with --keep-existing'
  [[ "$SEED_STATE" != true && "$LATEST_STATE" != true ]] || fail '--seed and --latest-state require a persistent workspace stack'
  [[ "$COMMAND" == run ]] || fail "--rm cannot be combined with $COMMAND"
fi
case "$COMMAND" in
  list)
    if [[ "$REPLACE_CONTAINER" == true || "$REBUILD_IMAGE" == true ||
      "$KEEP_EXISTING" == true || "$NEW_STATE" == true || "$SEED_STATE" == true ||
      "$LATEST_STATE" == true || "$OAUTH_CALLBACK" == true || "$WORKSPACE_OPTION" == true ]]; then
      fail 'usage: pi list'
    fi
    ;;
  copy)
    [[ "$REBUILD_IMAGE" != true ]] || fail '--rebuild cannot be combined with copy'
    if [[ "$REPLACE_CONTAINER" == true || "$KEEP_EXISTING" == true || "$NEW_STATE" == true ||
      "$SEED_STATE" == true || "$LATEST_STATE" == true || "$OAUTH_CALLBACK" == true ]]; then
      fail 'copy cannot be combined with launch, state, or OAuth options'
    fi
    ;;
  shell)
    if [[ "$REPLACE_CONTAINER" == true ||
      "$KEEP_EXISTING" == true || "$NEW_STATE" == true || "$SEED_STATE" == true ||
      "$LATEST_STATE" == true || "$OAUTH_CALLBACK" == true ]]; then
      printf 'pi: shell cannot be combined with lifecycle, state, or OAuth options\n' >&2
      fail 'usage: pi shell [--root|-r]'
    fi
    ;;
  stop|remove)
    [[ "$OAUTH_CALLBACK" != true ]] || fail "--oauth cannot be combined with $COMMAND"
    [[ "$REBUILD_IMAGE" != true ]] || fail "--rebuild cannot be combined with $COMMAND"
    if [[ "$REPLACE_CONTAINER" == true || "$KEEP_EXISTING" == true || "$NEW_STATE" == true ||
      "$SEED_STATE" == true || "$LATEST_STATE" == true ]]; then
      fail "--replace, --keep-existing, --new-state, --seed, and --latest-state cannot be combined with $COMMAND"
    fi
    ;;
  update)
    if [[ "$REPLACE_CONTAINER" == true || "$REBUILD_IMAGE" == true || "$KEEP_EXISTING" == true ]]; then
      fail '--rebuild, --replace, and --keep-existing cannot be combined with update'
    fi
    ;;
esac

create_oauth_override

canonicalize_workspace() {
  local selected="$1"
  [[ "$selected" = /* ]] || selected="$INVOCATION_DIRECTORY/$selected"
  [[ -d "$selected" ]] || return 1
  (cd -P -- "$selected" && pwd)
}

workspace_path_with_missing_components() {
  local path="$1"
  local suffix=""
  local base
  local parent

  if [[ "$path" != /* ]]; then
    path="$INVOCATION_DIRECTORY/$path"
  fi

  while [[ ! -d "$path" ]]; do
    base="$(basename -- "$path")"
    [[ -n "$base" && "$base" != "/" ]] || break
    suffix="/$base$suffix"
    parent="$(dirname -- "$path")"
    [[ "$parent" != "$path" ]] || break
    path="$parent"
  done

  if [[ -d "$path" ]]; then
    path="$(cd -P -- "$path" && pwd)"
  fi
  printf '%s%s\n' "$path" "$suffix"
}

if [[ "$COMMAND" != list ]]; then
  if [[ -d "$WORKSPACE" ]]; then
    WORKSPACE="$(canonicalize_workspace "$WORKSPACE")"
  elif [[ "$COMMAND" == shell ]]; then
    WORKSPACE_MISSING=true
    WORKSPACE="$(workspace_path_with_missing_components "$WORKSPACE")"
  else
    printf 'pi: workspace does not exist: %s\n' "$WORKSPACE" >&2
    exit 1
  fi
fi

# Compose project names must match [a-z0-9][a-z0-9_-]*, so every other
# character, including dots, becomes a hyphen.
sanitize_slug() {
  local value="$1"
  value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9_-]/-/g' -e 's/^[^a-z0-9]*//' -e 's/[^a-z0-9]*$//' -e 's/-\{2,\}/-/g')"
  if [[ -z "$value" ]]; then
    value="workspace"
  fi
  printf '%s' "$value"
}

workspace_hash() {
  local digest
  if command -v shasum >/dev/null 2>&1; then
    digest="$(printf '%s' "$1" | shasum -a 256 | awk '{print substr($1, 1, 12)}')"
  elif command -v sha256sum >/dev/null 2>&1; then
    digest="$(printf '%s' "$1" | sha256sum | awk '{print substr($1, 1, 12)}')"
  else
    digest="$(printf '%s' "$1" | cksum | awk '{print $1}')"
  fi
  printf '%s' "$digest"
}

# --new-state runs the workspace against a separate, extra agent-state volume.
# The extra volume is never seeded, never a seed, and never the latest state.
EXTRA_AGENT_STATE_PREFIX="pi-agents-new-ws-"

set_workspace_identity() {
  local workspace_basename
  workspace_basename="$(basename -- "$WORKSPACE")"
  if [[ "$workspace_basename" == "/" || -z "$workspace_basename" ]]; then
    workspace_basename="root"
  fi
  WORKSPACE_BASENAME="$(sanitize_slug "$workspace_basename")"
  WORKSPACE_HASH="$(workspace_hash "$WORKSPACE")"
  PROJECT_NAME="pi-agents-pi-$WORKSPACE_BASENAME"
  CONTAINER_NAME="pi-agents-pi-$WORKSPACE_BASENAME"
  VOLUME_NAMESPACE="pi-agents-ws-$WORKSPACE_HASH"
  NORMAL_AGENT_STATE_VOLUME_NAME="${VOLUME_NAMESPACE}_pi-agent-state"
  SESSION_STATE_VOLUME_NAME="${VOLUME_NAMESPACE}_pi-sessions"
  BROWSER_STATE_VOLUME_NAME="${VOLUME_NAMESPACE}_agent-browser-state"
  EXTRA_AGENT_STATE_VOLUME_NAME="${EXTRA_AGENT_STATE_PREFIX}${WORKSPACE_HASH}_pi-agent-state"
  ACTIVE_AGENT_STATE_VOLUME_NAME="$NORMAL_AGENT_STATE_VOLUME_NAME"
  if [[ "$NEW_STATE" == true ]]; then
    ACTIVE_AGENT_STATE_VOLUME_NAME="$EXTRA_AGENT_STATE_VOLUME_NAME"
  fi
}

if [[ "$COMMAND" != list ]]; then
  set_workspace_identity
else
  WORKSPACE_BASENAME=""
  WORKSPACE_HASH=""
  PROJECT_NAME=""
  CONTAINER_NAME=""
  VOLUME_NAMESPACE=""
  NORMAL_AGENT_STATE_VOLUME_NAME=""
  SESSION_STATE_VOLUME_NAME=""
  BROWSER_STATE_VOLUME_NAME=""
  EXTRA_AGENT_STATE_VOLUME_NAME=""
  ACTIVE_AGENT_STATE_VOLUME_NAME=""
fi

CONFIG_PATH="${PI_AGENT_CONTAINERS_CONFIG_PATH:-$HOME/.config/pi-agent-containers}"
STATE_SEED_FILE="$CONFIG_PATH/seed"
SHELL_RC_DIRECTORY="$CONFIG_PATH/shell-rc"
set_host_shell_rc_paths() {
  HOST_SHELL_RC_FILE=""
  HOST_SHELL_RC_SOURCE=""
  if [[ "$NO_RC_CONFIG" -eq 0 ]]; then
    HOST_SHELL_RC_SOURCE="$SHELL_RC_DIRECTORY/$VOLUME_NAMESPACE"
    HOST_SHELL_RC_FILE="$HOST_SHELL_RC_SOURCE/rc"
  fi
}
set_host_shell_rc_paths
FORCE_RECREATE=false
if [[ "$REPLACE_CONTAINER" == true || "$NEW_STATE" == true ]]; then
  FORCE_RECREATE=true
fi
build_compose() {
  COMPOSE=(
    docker compose
    --project-name "$PROJECT_NAME"
    --project-directory "$ROOT"
    --file "$ROOT/compose.yml"
  )
  if [[ "$OAUTH_CALLBACK" == true ]]; then
    COMPOSE+=(--file "$ROOT/compose.oauth.yml")
    if [[ -n "$OAUTH_OVERRIDE_FILE" ]]; then
      COMPOSE+=(--file "$OAUTH_OVERRIDE_FILE")
    fi
  fi
  if [[ "$NO_RC_CONFIG" -eq 0 ]]; then
    COMPOSE+=(--file "$ROOT/compose.shell-rc.yml")
  fi
}

build_compose

run_compose() {
  env \
    PI_WORKSPACE="$WORKSPACE" \
    PI_WORKSPACE_BASENAME="$WORKSPACE_BASENAME" \
    PI_CONTAINER_NAME="$CONTAINER_NAME" \
    PI_PROJECT_NAME="$PROJECT_NAME" \
    PI_AGENT_STATE_VOLUME_NAME="$ACTIVE_AGENT_STATE_VOLUME_NAME" \
    PI_SESSION_STATE_VOLUME_NAME="$SESSION_STATE_VOLUME_NAME" \
    PI_BROWSER_STATE_VOLUME_NAME="$BROWSER_STATE_VOLUME_NAME" \
    PI_HOST_SHELL="$HOST_SHELL_NAME" \
    PI_HOST_RC_SOURCE="$HOST_SHELL_RC_SOURCE" \
    PI_HOST_RC_FILE="/tmp/pi-host-shellrc/rc" \
    PI_NO_RC_CONFIG="$NO_RC_CONFIG" \
    "${COMPOSE[@]}" "$@"
}

# Helper containers run the configured Pi service image rather than a second
# image that would have to be pulled separately and could drift from Pi's
# runtime. The image runs as node, so every helper passes an explicit user.
configured_service_image() {
  local images image
  images="$(run_compose config --images pi)" || fail 'could not determine the configured Pi service image'
  while IFS= read -r image; do
    [[ -n "$image" ]] || continue
    printf '%s' "$image"
    return 0
  done <<< "$images"
  printf '%s-pi' "$PROJECT_NAME"
}

HELPER_IMAGE=''
HELPER_IMAGE_PROJECT=''
ensure_helper_image() {
  [[ "$HELPER_IMAGE_PROJECT" != "$PROJECT_NAME" || -z "$HELPER_IMAGE" ]] || return 0
  HELPER_IMAGE="$(configured_service_image)" || return
  if [[ "$REBUILD_IMAGE" == true ]] || ! docker image inspect "$HELPER_IMAGE" >/dev/null 2>&1; then
    run_compose build pi || return
  fi
  HELPER_IMAGE_PROJECT="$PROJECT_NAME"
}

read_seed_pointer() {
  local value=""
  if [[ -s "$STATE_SEED_FILE" ]]; then
    IFS= read -r value < "$STATE_SEED_FILE"
  fi
  printf '%s' "$value"
}

write_seed_pointer() {
  local value="$1"
  local temporary_file
  mkdir -p -- "$CONFIG_PATH"
  temporary_file="$(mktemp "$CONFIG_PATH/.seed.XXXXXX")"
  printf '%s\n' "$value" > "$temporary_file"
  mv -f -- "$temporary_file" "$STATE_SEED_FILE"
}

clear_seed_pointer() {
  rm -f -- "$STATE_SEED_FILE"
}

volume_exists() {
  [[ -n "$1" ]] && docker volume inspect "$1" >/dev/null 2>&1
}

assert_managed_state_volume() {
  local volume="$1" expected_workspace="$2" expected_kind="$3" record managed workspace kind
  local delimiter=$'\037'
  record="$(docker volume inspect --format "{{index .Labels \"com.pi-agents.managed\"}}${delimiter}{{index .Labels \"com.pi-agents.workspace\"}}${delimiter}{{index .Labels \"com.pi-agents.state-kind\"}}" "$volume" 2>/dev/null)" ||
    fail "could not inspect state volume: $volume"
  IFS="$delimiter" read -r managed workspace kind <<< "$record"
  [[ "$managed" == true ]] || fail "state volume is not managed: $volume"
  [[ "$workspace" == "$expected_workspace" ]] || fail "state volume workspace label does not match: $volume"
  [[ "$kind" == "$expected_kind" ]] ||
    fail "state volume kind label does not match: $volume"
}

agent_state_volume_workspace() {
  local volume="$1" record managed workspace kind
  local delimiter=$'\037'
  record="$(docker volume inspect --format "{{index .Labels \"com.pi-agents.managed\"}}${delimiter}{{index .Labels \"com.pi-agents.workspace\"}}${delimiter}{{index .Labels \"com.pi-agents.state-kind\"}}" "$volume" 2>/dev/null)" || return 1
  IFS="$delimiter" read -r managed workspace kind <<< "$record"
  [[ "$managed" == true && "$workspace" == /* && "$kind" == agent ]] || return 1
  printf '%s' "$workspace"
}

extra_agent_state_volume_for_workspace() {
  printf '%s%s_pi-agent-state' "$EXTRA_AGENT_STATE_PREFIX" "$(workspace_hash "$1")"
}

assert_agent_state_volume() {
  if [[ "$ACTIVE_AGENT_STATE_VOLUME_NAME" == "$EXTRA_AGENT_STATE_VOLUME_NAME" ]]; then
    assert_managed_state_volume "$ACTIVE_AGENT_STATE_VOLUME_NAME" "$WORKSPACE" agent-extra
  else
    assert_managed_state_volume "$ACTIVE_AGENT_STATE_VOLUME_NAME" "$WORKSPACE" agent
  fi
}

ensure_workspace_volumes() {
  # Compose cannot safely add or reconcile labels on an already-existing
  # named volume: it prompts to recreate the volume, which could destroy Pi
  # state. Create the volumes first and let Compose consume them as external.
  # Existing volumes are deliberately left untouched.
  local volume kind
  for volume in "$ACTIVE_AGENT_STATE_VOLUME_NAME" "$SESSION_STATE_VOLUME_NAME" "$BROWSER_STATE_VOLUME_NAME"; do
    case "$volume" in
      "$EXTRA_AGENT_STATE_VOLUME_NAME") kind=agent-extra ;;
      "$ACTIVE_AGENT_STATE_VOLUME_NAME") kind=agent ;;
      "$SESSION_STATE_VOLUME_NAME") kind=sessions ;;
      *) kind=browser ;;
    esac
    if ! volume_exists "$volume"; then
      docker volume create \
        --label com.pi-agents.managed=true \
        --label "com.pi-agents.state-kind=$kind" \
        --label "com.pi-agents.workspace=$WORKSPACE" \
        --label "com.pi-agents.project=$PROJECT_NAME" \
        "$volume" >/dev/null
    fi
    if [[ "$volume" == "$ACTIVE_AGENT_STATE_VOLUME_NAME" ]]; then
      assert_agent_state_volume
    else
      assert_managed_state_volume "$volume" "$WORKSPACE" "$kind"
    fi
  done
}

volume_created_at() {
  local volume="$1"
  docker volume inspect --format '{{.CreatedAt}}' "$volume" 2>/dev/null
}

# Extra state volumes carry their own kind: they are never seed candidates and
# never the latest state.
list_managed_agent_state_volumes() {
  docker volume ls \
    --filter 'label=com.pi-agents.managed=true' \
    --filter 'label=com.pi-agents.state-kind=agent' \
    --format '{{.Name}}'
}

find_agent_state_volume_by_age() {
  local direction="$1"
  local excluded="${2:-}"
  local candidate
  local created_at
  local selected=""
  local selected_created_at=""

  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    [[ -n "$excluded" && "$candidate" == "$excluded" ]] && continue
    created_at="$(volume_created_at "$candidate" || true)"
    [[ -n "$created_at" ]] || continue
    if [[ -z "$selected" || \
      ( "$direction" == oldest && ( "$created_at" < "$selected_created_at" || \
        ( "$created_at" == "$selected_created_at" && "$candidate" < "$selected" ) ) ) || \
      ( "$direction" == newest && ( "$created_at" > "$selected_created_at" || \
        ( "$created_at" == "$selected_created_at" && "$candidate" > "$selected" ) ) ) ]]; then
      selected="$candidate"
      selected_created_at="$created_at"
    fi
  done < <(list_managed_agent_state_volumes)

  printf '%s' "$selected"
}

# A valid seed or pending source is a managed normal agent-state volume
# labelled with an absolute workspace path.
is_managed_agent_state_volume() {
  agent_state_volume_workspace "$1" >/dev/null
}

print_agent_state_volume_candidates() {
  local candidate created
  printf 'Managed Pi state volumes:\n' >&2
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    created="$(volume_created_at "$candidate" || true)"
    printf '  %s  (%s)\n' "$candidate" "${created:-unknown creation time}" >&2
  done < <(list_managed_agent_state_volumes)
}

confirm_missing_seed_pointer() {
  local candidate="$1"
  local answer="n"

  printf 'pi: warning: the seed pointer was not found.\n' >&2
  print_agent_state_volume_candidates
  printf 'pi: the oldest managed agent-state volume is:\n  %s\n' "$candidate" >&2
  printf 'pi: use it as the seed for this new workspace? [y/N] ' >&2
  if IFS= read -r answer; then
    case "$answer" in
      y|Y|yes|YES)
        is_managed_agent_state_volume "$candidate" || fail 'selected seed volume is no longer valid'
        write_seed_pointer "$candidate"
        return 0
        ;;
    esac
  fi

  printf 'pi: seed selection cancelled; workspace was not started\n' >&2
  return 2
}

STATE_VOLUME_ALREADY_INITIALIZED=false
STATE_INITIALIZATION_PENDING=false
STATE_INITIAL_SOURCE=''

# Exit status 0 means initialized, 10 pending, 11 never initialized.
state_initialization_status() {
  local status
  ensure_helper_image || return 2
  if docker run --rm --user 0:0 -v "$ACTIVE_AGENT_STATE_VOLUME_NAME:/state:ro" "$HELPER_IMAGE" sh -c \
    '[ -d /state ] || exit 43; [ ! -f /state/.container-initialized ] || exit 0; [ ! -f /state/.container-initialization-pending ] || exit 10; exit 11'; then
    return 0
  else
    status=$?
  fi
  case "$status" in
    10|11) return "$status" ;;
    *) return 2 ;;
  esac
}

# Pi writes real login state to auth.json and provider/model preferences to
# settings.json; models-store.json alone can appear during a fresh startup.
# Returns 0 for useful state, 1 for none, and 2 when inspection fails.
state_volume_has_auth_or_settings() {
  local status
  ensure_helper_image || return 2
  if docker run --rm --user 0:0 -v "$1:/state:ro" "$HELPER_IMAGE" sh -c \
    '[ -d /state ] || exit 43; auth=""; if [ -r /state/auth.json ]; then auth=$(tr -d "[:space:]" < /state/auth.json 2>/dev/null || true); fi; if [ -n "$auth" ] && [ "$auth" != "{}" ]; then exit 0; fi; if grep -Eq "\"(defaultProvider|defaultModel)\"" /state/settings.json 2>/dev/null; then exit 0; fi; exit 42'; then
    return 0
  else
    status=$?
  fi
  [[ "$status" -ne 42 ]] || return 1
  printf 'pi: unable to inspect state volume for auth or settings: %s\n' "$1" >&2
  return 2
}

# The pending marker records the seed source before copying so an interrupted
# seed resumes from the same source instead of leaving partial state that a
# later launch would mistake for an initialized workspace.
mark_state_initialization() {
  local phase="$1" source_volume="${2:-}"
  ensure_helper_image
  docker run --rm --user 0:0 -v "$ACTIVE_AGENT_STATE_VOLUME_NAME:/state" "$HELPER_IMAGE" sh -c '
    set -eu
    phase=$1
    temporary=$(mktemp /state/.container-initialization.XXXXXX)
    if [ "$phase" = complete ]; then printf "%s\n" complete > "$temporary"; else printf "%s\n" "$2" > "$temporary"; fi
    chmod 0644 "$temporary"
    if [ "$phase" = complete ]; then
      mv -f "$temporary" /state/.container-initialized
      rm -f /state/.container-initialization-pending
    else
      mv -f "$temporary" /state/.container-initialization-pending
    fi
  ' state-initialization "$phase" "$source_volume"
}

prepare_state_lineage() {
  local seed
  local candidate
  local initialization_status
  local probe_status

  STATE_VOLUME_ALREADY_INITIALIZED=false
  STATE_INITIALIZATION_PENDING=false
  STATE_INITIAL_SOURCE=''
  # The extra --new-state volume is never seeded and never a seed candidate.
  [[ "$NEW_STATE" != true ]] || return 0
  ensure_helper_image
  if volume_exists "$NORMAL_AGENT_STATE_VOLUME_NAME"; then
    assert_managed_state_volume "$NORMAL_AGENT_STATE_VOLUME_NAME" "$WORKSPACE" agent
    if state_initialization_status; then initialization_status=0; else initialization_status=$?; fi
    case "$initialization_status" in
      0) STATE_VOLUME_ALREADY_INITIALIZED=true ;;
      10) STATE_INITIALIZATION_PENDING=true ;;
      11)
        # Volumes initialized before the markers existed, or filled by
        # `pi copy`, keep their state and are marked complete.
        if state_volume_has_auth_or_settings "$NORMAL_AGENT_STATE_VOLUME_NAME"; then
          STATE_VOLUME_ALREADY_INITIALIZED=true
          mark_state_initialization complete
        else
          probe_status=$?
          [[ "$probe_status" -eq 1 ]] || fail 'could not inspect uninitialized agent state'
        fi
        ;;
      *) fail 'could not inspect agent-state initialization status' ;;
    esac
    if [[ "$STATE_VOLUME_ALREADY_INITIALIZED" == true ]]; then
      [[ "$LATEST_STATE" != true ]] ||
        printf 'pi: warning: --latest-state has no effect; this workspace already has initialized agent state\n' >&2
      return 0
    fi
  fi
  if [[ "$STATE_INITIALIZATION_PENDING" == true ]]; then
    STATE_INITIAL_SOURCE="$(docker run --rm --user 0:0 -v "$NORMAL_AGENT_STATE_VOLUME_NAME:/state:ro" "$HELPER_IMAGE" cat /state/.container-initialization-pending)" ||
      fail 'could not read the pending agent-state initialization source'
    [[ -n "$STATE_INITIAL_SOURCE" && "$STATE_INITIAL_SOURCE" != "$NORMAL_AGENT_STATE_VOLUME_NAME" ]] &&
      is_managed_agent_state_volume "$STATE_INITIAL_SOURCE" ||
      fail "pending agent-state initialization source is unavailable; restore it before retrying: ${STATE_INITIAL_SOURCE:-unknown}"
    return 0
  fi
  # A missing or invalid seed is confirmed first, even with --latest-state.
  seed="$(read_seed_pointer)"
  if [[ -z "$seed" || "$seed" == "$NORMAL_AGENT_STATE_VOLUME_NAME" ]] || ! is_managed_agent_state_volume "$seed"; then
    seed=''
    candidate="$(find_agent_state_volume_by_age oldest "$NORMAL_AGENT_STATE_VOLUME_NAME")"
    if [[ -n "$candidate" ]]; then
      confirm_missing_seed_pointer "$candidate" || exit
      seed="$candidate"
    fi
  fi
  if [[ "$LATEST_STATE" == true ]]; then
    STATE_INITIAL_SOURCE="$(find_agent_state_volume_by_age newest "$NORMAL_AGENT_STATE_VOLUME_NAME")"
  else
    STATE_INITIAL_SOURCE="$seed"
  fi
}

initialize_agent_state() {
  local probe_status initialization_status

  # A per-workspace volume is seeded once from an existing state volume. The
  # source is mounted read-only and sessions are excluded so each workspace
  # starts with common login/configuration files but not another agent's
  # conversation history.
  [[ "$STATE_VOLUME_ALREADY_INITIALIZED" != true ]] || return 0
  ensure_helper_image
  if [[ "$NEW_STATE" == true ]]; then
    # Mark the empty extra volume initialized so no seeding logic ever runs.
    if state_initialization_status; then initialization_status=0; else initialization_status=$?; fi
    case "$initialization_status" in
      0) return 0 ;;
      10|11) mark_state_initialization complete; return ;;
      *) fail 'could not inspect agent-state initialization status' ;;
    esac
  fi
  if [[ -n "$STATE_INITIAL_SOURCE" ]]; then
    if [[ "$STATE_INITIALIZATION_PENDING" != true ]]; then
      if state_volume_has_auth_or_settings "$NORMAL_AGENT_STATE_VOLUME_NAME"; then
        fail 'refusing to seed an agent-state volume that already contains auth or settings'
      else
        probe_status=$?
        [[ "$probe_status" -eq 1 ]] || fail 'refusing to seed because agent-state inspection failed'
      fi
    fi
    mark_state_initialization pending "$STATE_INITIAL_SOURCE"
    docker run --rm --user 0:0 \
      -v "$STATE_INITIAL_SOURCE:/state-source:ro" \
      -v "$NORMAL_AGENT_STATE_VOLUME_NAME:/state-target" \
      "$HELPER_IMAGE" \
      sh -c 'set -eu; find /state-source -mindepth 1 -maxdepth 1 ! -name sessions ! -name .container-initialized ! -name ".container-initialization*" -exec cp -a {} /state-target/ \; ; chown -R 1000:1000 /state-target'
  fi
  mark_state_initialization complete
}

repair_state_permissions() {
  # State volumes can predate the current image or have been written by a
  # root sidecar. Repair them before Pi starts so its node user can write
  # auth, settings, models, sessions, and browser state without data loss.
  ensure_helper_image
  docker run --rm --user 0:0 \
    -v "$ACTIVE_AGENT_STATE_VOLUME_NAME:/state" \
    -v "$SESSION_STATE_VOLUME_NAME:/sessions" \
    -v "$BROWSER_STATE_VOLUME_NAME:/browser" \
    "$HELPER_IMAGE" \
    sh -c 'set -eu; for path in /state /sessions /browser; do chown -R 1000:1000 "$path"; find "$path" -type d -exec chmod u+rwx {} +; find "$path" -type f -exec chmod u+rw {} +; done'
}

remove_workspace_volumes() {
  local volume
  local status=0

  for volume in \
    "$NORMAL_AGENT_STATE_VOLUME_NAME" \
    "$EXTRA_AGENT_STATE_VOLUME_NAME" \
    "$SESSION_STATE_VOLUME_NAME" \
    "$BROWSER_STATE_VOLUME_NAME"; do
    if volume_exists "$volume"; then
      if ! docker volume rm "$volume"; then
        status=1
      fi
    fi
  done

  return "$status"
}

# Warns, without blocking, while the workspace has an extra --new-state volume.
warn_extra_state_volume() {
  volume_exists "$EXTRA_AGENT_STATE_VOLUME_NAME" || return 0
  if [[ "$NEW_STATE" == true ]]; then
    printf 'pi: warning: using the extra state volume %s; the normal state volume %s is untouched\n' \
      "$EXTRA_AGENT_STATE_VOLUME_NAME" "$NORMAL_AGENT_STATE_VOLUME_NAME" >&2
  else
    printf 'pi: warning: an extra state volume %s exists and is not in use; use it with --new-state, or remove it with `pi remove --all` (also removes the normal state volumes)\n' \
      "$EXTRA_AGENT_STATE_VOLUME_NAME" >&2
  fi
}

# The seed moves only for --seed. A missing or invalid pointer is claimed only
# by the first stack: with other managed normal agent-state volumes it stays
# unset so the next new workspace asks which state to seed from instead of an
# already-initialized workspace silently becoming the seed.
record_state_lineage() {
  local seed candidate

  # A run on the extra state volume never records it as the seed.
  [[ "$NEW_STATE" != true ]] || return 0
  if [[ "$SEED_STATE" == true ]]; then
    write_seed_pointer "$NORMAL_AGENT_STATE_VOLUME_NAME"
    return 0
  fi
  seed="$(read_seed_pointer)"
  if [[ -n "$seed" ]] && is_managed_agent_state_volume "$seed"; then return 0; fi
  while IFS= read -r candidate; do
    [[ -z "$candidate" || "$candidate" == "$NORMAL_AGENT_STATE_VOLUME_NAME" ]] || return 0
  done < <(list_managed_agent_state_volumes)
  write_seed_pointer "$NORMAL_AGENT_STATE_VOLUME_NAME"
}

# Keeps a seed that is still a managed normal agent-state volume; otherwise
# moves it to the oldest remaining one, or deletes the pointer when none remain.
repoint_seed_after_removal() {
  local seed candidate
  seed="$(read_seed_pointer)"
  if [[ -n "$seed" ]] && is_managed_agent_state_volume "$seed"; then return 0; fi
  candidate="$(find_agent_state_volume_by_age oldest)"
  if [[ -n "$candidate" ]]; then
    write_seed_pointer "$candidate"
    printf 'pi: the previous seed was removed; seed reassigned to oldest state %s\n' "$candidate" >&2
  else
    clear_seed_pointer
  fi
}

list_stacks() {
  local names name record status created started workspace project agent sessions browser seed latest marker_text
  local normal_agent extra_agent extra_text active_text marker_volume
  local delimiter=$'\037'
  local -a markers
  LISTED_MANAGED_VOLUME_NAMES=$'\n'
  names="$(docker ps -a --filter 'label=com.pi-agents.managed=true' --filter 'label=com.pi-agents.workspace' \
    --filter 'label=com.docker.compose.oneoff=False' --format '{{.Names}}' | sort)"
  seed="$(read_seed_pointer)"
  latest="$(find_agent_state_volume_by_age newest)"
  if [[ -z "$names" ]]; then
    printf 'No Pi stacks found.\n'
  else
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      record="$(docker inspect --format "{{.Name}}${delimiter}{{.State.Status}}${delimiter}{{.Created}}${delimiter}{{.State.StartedAt}}${delimiter}{{index .Config.Labels \"com.pi-agents.workspace\"}}${delimiter}{{index .Config.Labels \"com.docker.compose.project\"}}${delimiter}{{range .Mounts}}{{if eq .Destination \"/home/node/.pi/agent\"}}{{.Name}}{{end}}{{end}}${delimiter}{{range .Mounts}}{{if eq .Destination \"/home/node/.pi/agent/sessions\"}}{{.Name}}{{end}}{{end}}${delimiter}{{range .Mounts}}{{if eq .Destination \"/home/node/.agent-browser\"}}{{.Name}}{{end}}{{end}}" -- "$name")"
      IFS="$delimiter" read -r name status created started workspace project agent sessions browser <<< "$record"
      name="${name#/}"
      [[ "$started" != 0001-* ]] || started=never
      # Seed and latest only ever point at normal agent volumes; a stack running
      # on its extra volume still owns its normal one.
      normal_agent="pi-agents-ws-$(workspace_hash "$workspace")_pi-agent-state"
      extra_agent="$(extra_agent_state_volume_for_workspace "$workspace")"
      extra_text=none
      ! volume_exists "$extra_agent" || extra_text="$extra_agent"
      case "$agent" in
        '') active_text=none ;;
        "$extra_agent") active_text=extra ;;
        "$normal_agent") active_text=normal ;;
        *) active_text=unknown ;;
      esac
      LISTED_MANAGED_VOLUME_NAMES+="${agent:-}"$'\n'"${sessions:-}"$'\n'"${browser:-}"$'\n'"$normal_agent"$'\n'"$extra_agent"$'\n'
      marker_volume="$agent"
      [[ "$agent" != "$extra_agent" ]] || marker_volume="$normal_agent"
      markers=()
      [[ -z "$marker_volume" || "$marker_volume" != "$seed" ]] || markers+=(seed)
      [[ -z "$marker_volume" || "$marker_volume" != "$latest" ]] || markers+=(latest)
      marker_text=-
      if ((${#markers[@]})); then
        marker_text="${markers[0]}"
        [[ ${#markers[@]} -lt 2 ]] || marker_text+=",${markers[1]}"
      fi
      printf 'STACK: %s\n  status: %s\n  workspace: %s\n  project: %s\n  created: %s\n  started: %s\n  agent-state: %s\n  active-state: %s\n  extra-state: %s\n  session-state: %s\n  browser-state: %s\n  markers: %s\n' \
        "$name" "$status" "$workspace" "$project" "$created" "$started" "${agent:-none}" "$active_text" "$extra_text" "${sessions:-none}" "${browser:-none}" "$marker_text"
    done <<< "$names"
  fi
  list_orphaned_volumes "$seed" "$latest"
}

# Managed state volumes that no listed stack mounts or owns.
list_orphaned_volumes() {
  local seed="$1" latest="$2" volumes volume record created workspace project kind marker_text
  local delimiter=$'\037' printed=false
  local -a markers
  volumes="$(docker volume ls --filter 'label=com.pi-agents.managed=true' --format '{{.Name}}')"
  while IFS= read -r volume; do
    [[ -n "$volume" ]] || continue
    [[ "$LISTED_MANAGED_VOLUME_NAMES" != *$'\n'"$volume"$'\n'* ]] || continue
    record="$(docker volume inspect --format "{{.Name}}${delimiter}{{.CreatedAt}}${delimiter}{{index .Labels \"com.pi-agents.workspace\"}}${delimiter}{{index .Labels \"com.pi-agents.project\"}}${delimiter}{{index .Labels \"com.pi-agents.state-kind\"}}" "$volume")"
    IFS="$delimiter" read -r volume created workspace project kind <<< "$record"
    markers=()
    if [[ "$kind" == agent ]]; then
      [[ "$volume" != "$seed" ]] || markers+=(seed)
      [[ "$volume" != "$latest" ]] || markers+=(latest)
    fi
    marker_text=-
    if ((${#markers[@]})); then
      marker_text="${markers[0]}"
      [[ ${#markers[@]} -lt 2 ]] || marker_text+=",${markers[1]}"
    fi
    if [[ "$printed" == false ]]; then
      printf 'ORPHAN VOLUMES:\n'
      printed=true
    fi
    printf 'VOLUME: %s\n  kind: %s\n  workspace: %s\n  project: %s\n  created: %s\n  markers: %s\n' \
      "$volume" "${kind:-unknown}" "${workspace:-unknown}" "${project:-unknown}" "$created" "$marker_text"
  done <<< "$volumes"
}

# The agent-state volume the workspace container currently mounts, if any.
mounted_agent_state_volume() {
  docker container inspect --format '{{range .Mounts}}{{if eq .Destination "/home/node/.pi/agent"}}{{.Name}}{{end}}{{end}}' "$1"
}

start_persistent_service() {
  local -a up_args=(up)
  local mounted_agent_state=''
  ensure_workspace_volumes
  # The helper image is the service image, so --rebuild builds it once here
  # and Compose recreates the service from the new image.
  ensure_helper_image
  up_args+=(--detach)
  # Switching between the normal and extra agent-state volumes always moves
  # the container onto the requested volume.
  if docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
    mounted_agent_state="$(mounted_agent_state_volume "$CONTAINER_NAME")" || fail 'could not inspect agent state mount'
  fi
  if [[ "$FORCE_RECREATE" == true ||
    ( -n "$mounted_agent_state" && "$mounted_agent_state" != "$ACTIVE_AGENT_STATE_VOLUME_NAME" ) ]]; then
    up_args+=(--force-recreate)
  fi
  up_args+=(pi)
  run_compose "${up_args[@]}"
  warn_extra_state_volume
}

pi_shell_alias_setup_script() {
  cat <<'PI_SHELL_ALIAS_SETUP'
set -eu
[ "${PI_NO_RC_CONFIG:-0}" != 1 ] || exit 0

settings_file="${HOME:-/home/node}/.pi/agent/settings.json"
mkdir -p "$(dirname "$settings_file")"
if [ ! -e "$settings_file" ]; then
  umask 077
  printf '{}\n' > "$settings_file"
fi

marker='# pi-agents managed host shell aliases'
managed_prefix=$(printf '%s\n' \
  "$marker" \
  'shopt -s expand_aliases' \
  'if [ "${PI_NO_RC_CONFIG:-0}" != 1 ] && [ -r "${PI_HOST_RC_FILE:-/tmp/pi-host-shellrc/rc}" ]; then' \
  "  eval \"\$(grep -E '^[[:space:]]*alias[[:space:]]' \"\${PI_HOST_RC_FILE:-/tmp/pi-host-shellrc/rc}\")\"" \
  'fi')

if jq -e --arg marker "$marker" \
  '(.shellCommandPrefix // "") | strings | contains($marker)' \
  "$settings_file" >/dev/null 2>&1; then
  exit 0
fi

temporary_file=$(mktemp "${settings_file}.pi-agents.XXXXXX")
trap 'rm -f "$temporary_file"' EXIT HUP INT TERM
jq --arg prefix "$managed_prefix" '
  if type != "object" then error("Pi settings must contain a JSON object")
  elif .shellCommandPrefix == null then .shellCommandPrefix = $prefix
  elif (.shellCommandPrefix | type) != "string" then error("Pi shellCommandPrefix must be a string")
  elif .shellCommandPrefix == "" then .shellCommandPrefix = $prefix
  else .shellCommandPrefix += "\n" + $prefix
  end
' "$settings_file" > "$temporary_file"
chmod 600 "$temporary_file"
mv -f "$temporary_file" "$settings_file"
trap - EXIT HUP INT TERM
PI_SHELL_ALIAS_SETUP
}

configure_pi_shell_aliases() {
  [[ "$NO_RC_CONFIG" -eq 0 ]] || return 0
  run_compose exec -T pi sh -c "$(pi_shell_alias_setup_script)"
}

install_browser_extension() {
  # The extension must be registered in the mounted Pi agent state, not only
  # installed in the image: /home/node/.pi/agent is a per-workspace volume.
  run_compose exec pi pi-shell-launch pi-session-log --forward-output install "$PI_BROWSER_EXTENSION_SOURCE"
}

path_component() {
  printf '%s\n' "$1" | awk -F/ -v index="$2" '{print $index}'
}

path_slug_from_index() {
  printf '%s\n' "$1" | awk -F/ -v start="$2" '{
    value = ""
    for (i = start; i <= NF; i++) {
      if ($i == "") continue
      if (value != "") value = value "-"
      value = value $i
    }
    print value
  }'
}

find_first_path_difference() {
  local index=2
  local reference
  local path
  local same

  while [[ "$index" -le 1024 ]]; do
    reference="$(path_component "$WORKSPACE" "$index")"
    if [[ -z "$reference" ]]; then
      printf '2'
      return
    fi

    same=true
    for path in "${COLLISION_PATHS[@]}"; do
      if [[ "$(path_component "$path" "$index")" != "$reference" ]]; then
        same=false
        break
      fi
    done
    if [[ "$same" == false ]]; then
      printf '%s' "$index"
      return
    fi
    ((index += 1))
  done

  printf '2'
}

is_running_status() {
  case "$1" in
    Up*|Restarting*|Paused*) return 0 ;;
    *) return 1 ;;
  esac
}

prompt_collision() {
  local index
  local status
  local has_running=false

  printf '\nWorkspace container collision detected.\n\n' >&2
  printf 'Requested workspace:\n  %s\n\n' "$WORKSPACE" >&2
  for index in "${!COLLISION_NAMES[@]}"; do
    status="${COLLISION_STATUSES[$index]}"
    printf 'Existing container:\n  %s\n  workspace: %s\n  status: %s\n\n' \
      "${COLLISION_NAMES[$index]}" "${COLLISION_PATHS[$((index + 1))]}" "$status" >&2
    if is_running_status "$status"; then
      has_running=true
    fi
  done

  if [[ "$has_running" == true ]]; then
    printf '¡¡¡ WARNING !!! Renaming/recreating the existing container may interrupt processes currently running inside it.\n\n' >&2
  fi

  printf 'Choose:\n  [r] Rename/recreate the existing container\n  [k] Keep it unchanged and disambiguate this workspace\n  [c] Cancel\n\nChoice [c]: ' >&2
  local choice
  if ! IFS= read -r choice; then
    choice="c"
  fi
  case "$choice" in
    r|R) printf 'r' ;;
    k|K) printf 'k' ;;
    *) printf 'c' ;;
  esac
}

# Only persistent service containers match unless allow-oneoff is true, which
# also accepts `docker compose run` one-offs such as `pi --rm` containers.
inspect_workspace_container() {
  local name="$1" expected_workspace="$2" expected_project="${3:-}" allow_oneoff="${4:-false}"
  local record actual_name managed workspace project service oneoff
  local delimiter=$'\037'
  record="$(docker inspect --format "{{.Name}}${delimiter}{{index .Config.Labels \"com.pi-agents.managed\"}}${delimiter}{{index .Config.Labels \"com.pi-agents.workspace\"}}${delimiter}{{index .Config.Labels \"com.docker.compose.project\"}}${delimiter}{{index .Config.Labels \"com.docker.compose.service\"}}${delimiter}{{index .Config.Labels \"com.docker.compose.oneoff\"}}" "$name" 2>/dev/null)" || return 2
  IFS="$delimiter" read -r actual_name managed workspace project service oneoff <<< "$record"
  if [[ "$actual_name" != "/$name" || "$managed" != true ||
    "$workspace" != "$expected_workspace" || -z "$project" || "$project" == '<no value>' ||
    "$service" != pi ]] || ! [[ "$oneoff" == False || ( "$allow_oneoff" == true && "$oneoff" == True ) ]]; then
    printf 'pi: container identity does not match workspace: %s\n' "$name" >&2
    return 2
  fi
  if [[ -n "$expected_project" && "$project" != "$expected_project" ]]; then
    printf 'pi: container project does not match: %s\n' "$name" >&2
    return 2
  fi
  INSPECTED_PROJECT="$project"
}

# A Compose project may only contain containers owned by the same workspace:
# its persistent service and its own `pi --rm` one-offs.
assert_project_available() {
  local project="$1" workspace="$2" rows name
  rows="$(docker ps -a --filter "label=com.docker.compose.project=$project" --format '{{.Names}}')" || return 2
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    inspect_workspace_container "$name" "$workspace" "$project" true || return 2
  done <<< "$rows"
}

assert_container_name_available() {
  local name="$1" workspace="$2"
  if docker container inspect "$name" >/dev/null 2>&1; then
    inspect_workspace_container "$name" "$workspace" || return 2
  fi
}

prepare_workspace_container() {
  local rows
  local id
  local name
  local status
  local path
  local index
  local first_difference
  local slug
  local target
  local choice
  local same_workspace_name=""
  local same_workspace_project=""
  local has_collision=false

  COLLISION_NAMES=()
  COLLISION_STATUSES=()
  COLLISION_PATHS=("$WORKSPACE")

  rows="$(docker ps -a \
    --filter 'label=com.pi-agents.managed=true' \
    --filter "label=com.pi-agents.workspace-basename=$WORKSPACE_BASENAME" \
    --filter 'label=com.docker.compose.oneoff=False' \
    --format '{{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Label "com.pi-agents.workspace"}}')"

  while IFS=$'\t' read -r id name status path; do
    [[ -n "$id" ]] || continue
    [[ -n "$path" ]] || continue
    inspect_workspace_container "$name" "$path" || fail "invalid managed container: $name"
    if [[ "$path" == "$WORKSPACE" ]]; then
      [[ -z "$same_workspace_name" ]] || fail "multiple stacks found for workspace: $WORKSPACE"
      same_workspace_name="$name"
      same_workspace_project="$INSPECTED_PROJECT"
      continue
    fi
    COLLISION_NAMES+=("$name")
    COLLISION_STATUSES+=("$status")
    COLLISION_PATHS+=("$path")
    has_collision=true
  done <<< "$rows"

  # The workspace's own stack is reused as-is, whatever name it was given by an
  # earlier collision; other same-basename stacks are left untouched.
  if [[ -n "$same_workspace_name" ]]; then
    CONTAINER_NAME="$same_workspace_name"
    PROJECT_NAME="$same_workspace_project"
  elif [[ "$has_collision" == true ]]; then
    first_difference="$(find_first_path_difference)"
    COLLISION_TARGET_NAMES=()
    for path in "${COLLISION_PATHS[@]}"; do
      slug="$(sanitize_slug "$(path_slug_from_index "$path" "$first_difference")")"
      COLLISION_TARGET_NAMES+=("pi-agents-pi-${slug:0:100}-$(workspace_hash "$path")")
    done

    # Validate every destination before the first rename so a partial rename
    # never leaves stacks under names that do not match their workspaces.
    for index in "${!COLLISION_TARGET_NAMES[@]}"; do
      assert_container_name_available "${COLLISION_TARGET_NAMES[$index]}" "${COLLISION_PATHS[$index]}" ||
        fail "disambiguated container name is occupied: ${COLLISION_TARGET_NAMES[$index]}"
      assert_project_available "${COLLISION_TARGET_NAMES[$index]}" "${COLLISION_PATHS[$index]}" ||
        fail "disambiguated Compose project is occupied: ${COLLISION_TARGET_NAMES[$index]}"
    done

    if [[ "$KEEP_EXISTING" == true ]]; then
      choice="k"
    else
      choice="$(prompt_collision)"
    fi

    case "$choice" in
      r)
        for index in "${!COLLISION_NAMES[@]}"; do
          target="${COLLISION_TARGET_NAMES[$((index + 1))]}"
          if [[ "${COLLISION_NAMES[$index]}" != "$target" ]]; then
            docker rename "${COLLISION_NAMES[$index]}" "$target"
          fi
        done
        FORCE_RECREATE=true
        ;;
      k) ;;
      *) fail 'workspace container collision cancelled' ;;
    esac
    CONTAINER_NAME="${COLLISION_TARGET_NAMES[0]}"
    PROJECT_NAME="$CONTAINER_NAME"
  fi

  assert_container_name_available "$CONTAINER_NAME" "$WORKSPACE" || fail "workspace container name is occupied: $CONTAINER_NAME"
  assert_project_available "$PROJECT_NAME" "$WORKSPACE" || fail "workspace Compose project is occupied: $PROJECT_NAME"
  build_compose
}

# Disposable runs must never prompt or rename, and must not fall back to the
# basename project, which may belong to another workspace.
resolve_workspace_project() {
  local original_keep_existing="$KEEP_EXISTING"
  KEEP_EXISTING=true
  prepare_workspace_container
  KEEP_EXISTING="$original_keep_existing"
}

# stop and remove act only on the stack labelled with this exact workspace.
# Returns 1 when the workspace has no stack; other failures exit.
find_exact_workspace_stack() {
  local rows id name project count=0
  rows="$(docker ps -a \
    --filter 'label=com.pi-agents.managed=true' \
    --filter "label=com.pi-agents.workspace=$WORKSPACE" \
    --filter 'label=com.docker.compose.oneoff=False' \
    --format '{{.ID}}\t{{.Names}}\t{{.Label "com.docker.compose.project"}}')" ||
    fail 'could not list workspace stacks'
  while IFS=$'\t' read -r id name project; do
    [[ -n "$id" && -n "$name" && -n "$project" ]] || continue
    count=$((count + 1))
    (( count == 1 )) || fail "multiple stacks found for workspace: $WORKSPACE"
    inspect_workspace_container "$name" "$WORKSPACE" "$project" || fail "stack identity does not match workspace: $name"
    CONTAINER_NAME="$name"
    PROJECT_NAME="$project"
  done <<< "$rows"
  (( count == 1 )) || return 1
  assert_project_available "$PROJECT_NAME" "$WORKSPACE" || fail 'workspace Compose project is shared with another stack'
  build_compose
}

resolve_exact_workspace_stack() {
  find_exact_workspace_stack || fail "no stack found for workspace: $WORKSPACE"
}

# Lists this workspace's existing state volumes as `name<TAB>kind` rows.
workspace_state_volume_rows() {
  local volume kind labelled
  local -A seen=()
  for volume in "$NORMAL_AGENT_STATE_VOLUME_NAME" "$SESSION_STATE_VOLUME_NAME" \
    "$BROWSER_STATE_VOLUME_NAME" "$EXTRA_AGENT_STATE_VOLUME_NAME"; do
    volume_exists "$volume" || continue
    seen[$volume]=1
    case "$volume" in
      "$NORMAL_AGENT_STATE_VOLUME_NAME") kind=agent ;;
      "$SESSION_STATE_VOLUME_NAME") kind=sessions ;;
      "$BROWSER_STATE_VOLUME_NAME") kind=browser ;;
      *) kind=agent-extra ;;
    esac
    printf '%s\t%s\n' "$volume" "$kind"
  done
  labelled="$(docker volume ls --filter 'label=com.pi-agents.managed=true' \
    --filter "label=com.pi-agents.workspace=$WORKSPACE" \
    --format '{{.Name}}\t{{.Label "com.pi-agents.state-kind"}}' 2>/dev/null || true)"
  while IFS=$'\t' read -r volume kind; do
    [[ -n "$volume" && -z "${seen[$volume]:-}" ]] || continue
    seen[$volume]=1
    printf '%s\t%s\n' "$volume" "${kind:-unknown}"
  done <<< "$labelled"
}

# `remove --all` without a stack: let the user leave, delete all, or delete
# selected leftover state volumes of this workspace.
remove_orphaned_workspace_volumes() {
  local rows volume kind created choice selection token index status=0
  local -a volumes=() kinds=() selected=() tokens=()
  local -A chosen=()
  rows="$(workspace_state_volume_rows)"
  while IFS=$'\t' read -r volume kind; do
    [[ -n "$volume" ]] || continue
    volumes+=("$volume")
    kinds+=("$kind")
  done <<< "$rows"
  ((${#volumes[@]} > 0)) || fail "no stack or state volumes found for workspace: $WORKSPACE"

  printf 'pi: no stack found for workspace: %s\n' "$WORKSPACE" >&2
  printf 'Existing state volumes:\n' >&2
  for index in "${!volumes[@]}"; do
    created="$(volume_created_at "${volumes[$index]}" || true)"
    printf '  %s) %s\n     kind: %s\n     created: %s\n' "$((index + 1))" "${volumes[$index]}" \
      "${kinds[$index]}" "${created:-unknown}" >&2
  done
  printf '[l] Leave all volumes (default)  [a] Delete all  [s] Select volumes to delete\nChoice [l]: ' >&2
  IFS= read -r choice || choice=''
  case "$choice" in
    ''|l|L)
      printf 'pi: state volumes left unchanged\n' >&2
      return 0
      ;;
    a|A) selected=("${volumes[@]}") ;;
    s|S)
      printf 'Volumes to delete (numbers, space or comma separated; empty to cancel): ' >&2
      IFS= read -r selection || selection=''
      selection="${selection//,/ }"
      read -r -a tokens <<< "$selection"
      if ((${#tokens[@]} == 0)); then
        printf 'pi: state volumes left unchanged\n' >&2
        return 0
      fi
      for token in "${tokens[@]}"; do
        [[ "$token" =~ ^[0-9]+$ ]] || fail "invalid volume selection: $token"
        index=$((10#$token - 1))
        (( index >= 0 && index < ${#volumes[@]} )) || fail "invalid volume selection: $token"
        [[ -z "${chosen[$index]:-}" ]] || fail "duplicate volume selection: $token"
        chosen[$index]=1
        selected+=("${volumes[$index]}")
      done
      ;;
    *) fail "invalid choice: $choice" ;;
  esac

  for volume in "${selected[@]}"; do
    if docker volume rm "$volume" >/dev/null; then
      printf 'pi: removed state volume %s\n' "$volume" >&2
    else
      printf 'pi: could not remove state volume %s\n' "$volume" >&2
      status=1
    fi
  done
  repoint_seed_after_removal
  return "$status"
}

# Reads a picker choice into PICKER_CHOICE. A single key selects at once and
# briefly drains input buffered after it, such as the rest of a pasted line.
# With ten or more numbered entries, a leading 1-9 could begin a longer number,
# so the rest of the line is read up to Enter; 0, Esc, and x stay single keys.
read_picker_choice() {
  local count="$1" rest=''
  PICKER_CHOICE=''
  if (( count >= 10 )); then
    printf 'Choice (number, then Enter): ' >&2
  else
    printf 'Choice: ' >&2
  fi
  IFS= read -r -n 1 PICKER_CHOICE || return 1
  if (( count >= 10 )) && [[ "$PICKER_CHOICE" == [1-9] ]]; then
    IFS= read -r rest || true
  else
    IFS= read -r -t 0.05 -n 1024 rest || true
  fi
  PICKER_CHOICE+="$rest"
}

list_shell_containers() {
  docker ps -a \
    --filter 'label=com.pi-agents.managed=true' \
    --filter 'label=com.pi-agents.workspace' \
    --filter 'label=com.docker.compose.oneoff=False' \
    --format '{{.ID}}\t{{.Names}}\t{{.Status}}\t{{.State}}\t{{.Label "com.pi-agents.workspace"}}'
}

select_shell_container() {
  local rows
  local id
  local name
  local status
  local state
  local path
  local choice
  local index
  local current_index=-1
  local current_count=0
  local new_project_option=false

  SHELL_NAMES=()
  SHELL_STATUSES=()
  SHELL_STATES=()
  SHELL_PATHS=()
  rows="$(list_shell_containers)"

  while IFS=$'\t' read -r id name status state path; do
    [[ -n "$id" && -n "$name" && -n "$path" ]] || continue
    SHELL_NAMES+=("$name")
    SHELL_STATUSES+=("$status")
    SHELL_STATES+=("$state")
    SHELL_PATHS+=("$path")
    if [[ "$path" == "$WORKSPACE" ]]; then
      current_index=$((${#SHELL_NAMES[@]} - 1))
      ((current_count += 1))
    fi
  done <<< "$rows"

  if [[ "$WORKSPACE_MISSING" == true || "$current_count" -eq 0 ]]; then
    new_project_option=true
  fi

  if [[ "$new_project_option" == false && "$current_count" -eq 1 ]]; then
    SHELL_SELECTED_NAME="${SHELL_NAMES[$current_index]}"
    SHELL_SELECTED_STATE="${SHELL_STATES[$current_index]}"
    SHELL_SELECTED_PATH="${SHELL_PATHS[$current_index]}"
    return 0
  fi

  printf 'Choose a Pi container:\n' >&2
  if [[ "$new_project_option" == true ]]; then
    printf '0) Start a new project\n' >&2
  fi
  for index in "${!SHELL_NAMES[@]}"; do
    printf '%s) %s\n   status: %s\n   workspace: %s\n' \
      "$((index + 1))" "${SHELL_NAMES[$index]}" \
      "${SHELL_STATUSES[$index]}" "${SHELL_PATHS[$index]}" >&2
  done
  printf 'X) Cancel (or Esc)\n' >&2
  if ! read_picker_choice "${#SHELL_NAMES[@]}"; then
    printf 'pi: container selection cancelled\n' >&2
    return 2
  fi
  choice="$PICKER_CHOICE"

  case "$choice" in
    $'\e'|x|X)
      printf 'pi: container selection cancelled\n' >&2
      return 2
      ;;
    0)
      if [[ "$new_project_option" == true ]]; then
        SHELL_START_NEW_PROJECT=true
        return 0
      fi
      ;;
  esac

  if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#SHELL_NAMES[@]} )); then
    printf 'pi: invalid container selection: %s\n' "$choice" >&2
    return 2
  fi

  index=$((choice - 1))
  SHELL_SELECTED_NAME="${SHELL_NAMES[$index]}"
  SHELL_SELECTED_STATE="${SHELL_STATES[$index]}"
  SHELL_SELECTED_PATH="${SHELL_PATHS[$index]}"
}

container_has_host_rc_mount() {
  local container="$1" mounted_source
  mounted_source="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/tmp/pi-host-shellrc"}}{{.Source}}{{end}}{{end}}' "$container" 2>/dev/null)" || return 1
  [[ -n "$mounted_source" ]]
}

attach_shell() {
  local requested_workspace="$WORKSPACE" mounted_agent_state
  local -a exec_arguments=(exec -it)
  select_shell_container
  if [[ "$SHELL_START_NEW_PROJECT" == true ]]; then
    mkdir -p -- "$WORKSPACE"
    WORKSPACE="$(canonicalize_workspace "$WORKSPACE")"
    WORKSPACE_MISSING=false
    set_workspace_identity
    set_host_shell_rc_paths
    prepare_host_shell_rc
    build_compose
    prepare_workspace_container
    prepare_state_lineage
    ensure_workspace_volumes
    initialize_agent_state
    repair_state_permissions
    start_persistent_service
    install_browser_extension
    record_state_lineage
    SHELL_SELECTED_NAME="$CONTAINER_NAME"
  else
    [[ "$REBUILD_IMAGE" != true || "$SHELL_SELECTED_PATH" == "$requested_workspace" ]] ||
      fail '--rebuild can only build the current workspace image; run `pi --rebuild shell` from the selected workspace'
    WORKSPACE="$SHELL_SELECTED_PATH"
    set_workspace_identity
    set_host_shell_rc_paths
    resolve_exact_workspace_stack
    # A shell keeps whichever agent state the stack mounts; it never switches.
    mounted_agent_state="$(mounted_agent_state_volume "$CONTAINER_NAME")" || fail 'could not inspect agent state mount'
    if [[ "$mounted_agent_state" == "$EXTRA_AGENT_STATE_VOLUME_NAME" ]]; then
      NEW_STATE=true
      ACTIVE_AGENT_STATE_VOLUME_NAME="$EXTRA_AGENT_STATE_VOLUME_NAME"
    fi
    prepare_host_shell_rc
    build_compose
    # A shell cannot pass launch options, so it only recreates the current
    # workspace's stack for --rebuild or a missing rc mount, for example after
    # --no-rc-config. Another workspace's stack keeps its mounts.
    if [[ "$REBUILD_IMAGE" == true ]]; then
      FORCE_RECREATE=true
      start_persistent_service
    elif [[ "$NO_RC_CONFIG" -eq 0 && "$SHELL_SELECTED_PATH" == "$requested_workspace" ]] &&
      ! container_has_host_rc_mount "$CONTAINER_NAME"; then
      start_persistent_service
    elif [[ "$SHELL_SELECTED_STATE" != running ]]; then
      run_compose start pi
      warn_extra_state_volume
    fi
    SHELL_SELECTED_NAME="$CONTAINER_NAME"
  fi
  inspect_workspace_container "$SHELL_SELECTED_NAME" "$WORKSPACE" "$PROJECT_NAME" || fail 'selected shell container identity changed'
  [[ "$SHELL_AS_ROOT" != true ]] || exec_arguments+=(--user 0)
  exec_arguments+=(--env "PI_HOST_SHELL=$HOST_SHELL_NAME" --env 'PI_HOST_RC_FILE=/tmp/pi-host-shellrc/rc'
    --env "PI_NO_RC_CONFIG=$NO_RC_CONFIG" "$SHELL_SELECTED_NAME" pi-shell-launch)
  docker "${exec_arguments[@]}"
}

run_state_copy() {
  local source_agent="$1" target_agent="$2" source_workspace="$3" target_workspace="$4" source_sessions="${5:-}" target_sessions="${6:-}"
  shift 6 || true
  local -a command tty_arguments=(-i)
  assert_managed_state_volume "$source_agent" "$source_workspace" agent
  assert_managed_state_volume "$target_agent" "$target_workspace" agent
  ensure_helper_image
  # The helper's item and duplicate pickers need a terminal when there is one.
  [[ ! -t 0 ]] || tty_arguments+=(-t)
  command=(docker run --rm "${tty_arguments[@]}" --user 0:0
    -v "$ROOT/bin/pi-state-copy:/usr/local/bin/pi-state-copy:ro"
    -v "$source_agent:/state-source:ro" -v "$target_agent:/state-target"
    "$HELPER_IMAGE" bash /usr/local/bin/pi-state-copy --source /state-source --target /state-target)
  if [[ -n "$source_sessions" && -n "$target_sessions" ]]; then
    assert_managed_state_volume "$source_sessions" "$source_workspace" sessions
    assert_managed_state_volume "$target_sessions" "$target_workspace" sessions
    command=(docker run --rm "${tty_arguments[@]}" --user 0:0
      -v "$ROOT/bin/pi-state-copy:/usr/local/bin/pi-state-copy:ro"
      -v "$source_agent:/state-source:ro" -v "$source_sessions:/state-source/sessions:ro"
      -v "$target_agent:/state-target" -v "$target_sessions:/state-target/sessions"
      "$HELPER_IMAGE" bash /usr/local/bin/pi-state-copy --source /state-source --target /state-target)
  fi
  command+=("$@")
  "${command[@]}"
}

repair_copied_state_permissions() {
  local agent_volume="$1" session_volume="${2:-}"
  local -a command mounts
  ensure_helper_image
  mounts=(-v "$agent_volume:/state")
  [[ -z "$session_volume" ]] || mounts+=(-v "$session_volume:/sessions")
  command=(docker run --rm --user 0:0 "${mounts[@]}" "$HELPER_IMAGE" sh -c
    'set -eu; for path in /state /sessions; do [ ! -d "$path" ] || { chown -R 1000:1000 "$path"; find "$path" -type d -exec chmod u+rwx {} +; find "$path" -type f -exec chmod u+rw {} +; }; done')
  "${command[@]}"
}

pick_managed_agent_volume() {
  local excluded="$1" prompt="$2" candidate workspace created choice index
  local -a volumes=() workspaces=()
  PICKED_AGENT_VOLUME=''
  PICKED_AGENT_WORKSPACE=''
  while IFS= read -r candidate; do
    [[ -n "$candidate" && "$candidate" != "$excluded" ]] || continue
    workspace="$(agent_state_volume_workspace "$candidate")" || continue
    volumes+=("$candidate")
    workspaces+=("$workspace")
  done < <(list_managed_agent_state_volumes)
  ((${#volumes[@]})) || fail 'no other managed Pi state volumes are available'
  printf '%s\n' "$prompt" >&2
  for index in "${!volumes[@]}"; do
    candidate="${volumes[$index]}"
    created="$(volume_created_at "$candidate" || true)"
    printf '%s) %s\n   workspace: %s\n   created: %s\n' "$((index + 1))" "$candidate" "${workspaces[$index]}" "${created:-unknown}" >&2
  done
  printf 'X) Cancel (or Esc)\n' >&2
  if ! read_picker_choice "${#volumes[@]}"; then
    printf 'pi: copy cancelled\n' >&2
    exit 3
  fi
  printf '\n' >&2
  choice="$PICKER_CHOICE"
  case "$choice" in x|X|$'\e') printf 'pi: copy cancelled\n' >&2; exit 3 ;; esac
  [[ "$choice" =~ ^[0-9]+$ ]] || fail "invalid state volume selection: $choice"
  index=$((10#$choice - 1))
  (( index >= 0 && index < ${#volumes[@]} )) || fail "invalid state volume selection: $choice"
  PICKED_AGENT_VOLUME="${volumes[$index]}"
  PICKED_AGENT_WORKSPACE="${workspaces[$index]}"
}

# Sessions live in their own volume mounted over the agent state's sessions/
# directory, so the copy helper mounts both. The volume is the one managed
# session volume labelled with the agent volume's workspace.
session_volume_for_agent_volume() {
  local agent_volume="$1" workspace candidate selected='' count=0
  workspace="$(docker volume inspect --format '{{index .Labels "com.pi-agents.workspace"}}' "$agent_volume")"
  [[ -n "$workspace" ]] || fail "managed state volume has no workspace label: $agent_volume"
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    selected="$candidate"
    count=$((count + 1))
  done < <(docker volume ls --filter 'label=com.pi-agents.managed=true' \
    --filter 'label=com.pi-agents.state-kind=sessions' \
    --filter "label=com.pi-agents.workspace=$workspace" --format '{{.Name}}')
  [[ "$count" -eq 1 ]] || fail "expected one managed session volume for state volume: $agent_volume"
  printf '%s' "$selected"
}

# A running Pi keeps cached auth and extension metadata, so name every running
# managed container whose agent state is the copy destination.
warn_running_copy_destination() {
  local destination="$1" name mounted
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    mounted="$(mounted_agent_state_volume "$name")" || continue
    [[ "$mounted" == "$destination" ]] || continue
    printf 'pi: warning: %s is mounted by running container %s; restart it to pick up copied auth or extensions\n' "$destination" "$name" >&2
  done < <(docker ps --filter 'label=com.pi-agents.managed=true' --format '{{.Names}}')
}

copy_agent_state() {
  local source_agent target_agent source_workspace target_workspace source_sessions='' target_sessions=''
  local -a copy_arguments=()
  ensure_workspace_volumes
  if [[ "$COPY_TO" == true ]]; then
    source_agent="$NORMAL_AGENT_STATE_VOLUME_NAME"
    source_workspace="$WORKSPACE"
    pick_managed_agent_volume "$source_agent" 'Choose a destination Pi state volume:'
    target_agent="$PICKED_AGENT_VOLUME"
    target_workspace="$PICKED_AGENT_WORKSPACE"
  else
    target_agent="$NORMAL_AGENT_STATE_VOLUME_NAME"
    target_workspace="$WORKSPACE"
    pick_managed_agent_volume "$target_agent" 'Choose a source Pi state volume:'
    source_agent="$PICKED_AGENT_VOLUME"
    source_workspace="$PICKED_AGENT_WORKSPACE"
  fi
  [[ "$COPY_SESSIONS" != true ]] || copy_arguments+=(--sessions)
  [[ "$COPY_AUTH" != true ]] || copy_arguments+=(--auth)
  [[ "$COPY_EXTENSIONS" != true ]] || copy_arguments+=(--extensions)
  [[ "$COPY_ALL" != true ]] || copy_arguments+=(--all)
  [[ "$COPY_OVERRIDE" != true ]] || copy_arguments+=(--override)
  assert_managed_state_volume "$source_agent" "$source_workspace" agent
  assert_managed_state_volume "$target_agent" "$target_workspace" agent
  # Sessions are copied unless category flags exclude them.
  if [[ "$COPY_SESSIONS" == true || ( "$COPY_SESSIONS" == false && "$COPY_AUTH" == false && "$COPY_EXTENSIONS" == false ) ]]; then
    source_sessions="$(session_volume_for_agent_volume "$source_agent")"
    target_sessions="$(session_volume_for_agent_volume "$target_agent")"
    volume_exists "$source_sessions" || fail "source session volume is unavailable: $source_sessions"
    volume_exists "$target_sessions" || fail "target session volume is unavailable: $target_sessions"
  fi
  printf 'pi: copying agent state from %s to %s\n' "$source_agent" "$target_agent" >&2
  repair_copied_state_permissions "$target_agent" "$target_sessions"
  run_state_copy "$source_agent" "$target_agent" "$source_workspace" "$target_workspace" "$source_sessions" "$target_sessions" ${copy_arguments[@]+"${copy_arguments[@]}"}
  printf 'pi: agent-state copy complete\n' >&2
  repair_copied_state_permissions "$target_agent" "$target_sessions"
  warn_running_copy_destination "$target_agent"
}

if [[ "$COMMAND" == copy ]]; then
  copy_agent_state
  exit $?
fi

if [[ "$COMMAND" == list ]]; then
  list_stacks
  exit $?
fi

if [[ "$COMMAND" == shell ]]; then
  attach_shell
  exit $?
fi

if [[ "$COMMAND" == remove ]]; then
  if ! find_exact_workspace_stack; then
    [[ "$REMOVE_VOLUMES" == true ]] || fail "no stack found for workspace: $WORKSPACE"
    remove_orphaned_workspace_volumes
    exit $?
  fi

  if [[ "$REMOVE_VOLUMES" == true ]]; then
    run_compose down
    removal_status=0
    if ! remove_workspace_volumes; then
      removal_status=1
    fi
    repoint_seed_after_removal
    if [[ "$removal_status" -ne 0 ]]; then
      exit "$removal_status"
    fi
  else
    run_compose down
    if volume_exists "$EXTRA_AGENT_STATE_VOLUME_NAME"; then
      printf 'pi: warning: state volumes are kept, including the extra state volume %s; use `pi remove --all` to remove them\n' \
        "$EXTRA_AGENT_STATE_VOLUME_NAME" >&2
    fi
  fi
  exit $?
fi

if [[ "$COMMAND" == stop ]]; then
  resolve_exact_workspace_stack
  run_compose stop
  exit $?
fi

if [[ "$COMMAND" == update ]]; then
  prepare_host_shell_rc
  prepare_workspace_container
  validate_oauth_ports
  prepare_state_lineage
  # State volumes are created, seeded, and repaired before the service starts
  # so Pi never runs against unseeded or unrepaired state.
  ensure_workspace_volumes
  if [[ "${#UPDATE_ARGS[@]}" -eq 0 ]]; then
    run_compose build --pull --no-cache pi
    initialize_agent_state
    repair_state_permissions
    FORCE_RECREATE=true
    start_persistent_service
    install_browser_extension
    record_state_lineage
    exit $?
  fi

  initialize_agent_state
  repair_state_permissions
  start_persistent_service
  install_browser_extension
  record_state_lineage
  run_logged_pi() {
    run_compose exec pi pi-shell-launch pi-session-log --forward-output "$@"
  }
  run_logged_pi update "${UPDATE_ARGS[@]}"
  exit $?
fi

if [[ "$REMOVE_AFTER_RUN" == true ]]; then
  resolve_workspace_project
  validate_oauth_ports
  prepare_host_shell_rc
  ensure_helper_image
  prepare_state_lineage
  ensure_workspace_volumes
  warn_extra_state_volume
  initialize_agent_state
  repair_state_permissions
  shell_alias_setup_script=""
  if [[ "$NO_RC_CONFIG" -eq 0 ]]; then
    shell_alias_setup_script="$(pi_shell_alias_setup_script)"
  fi
  run_compose run --rm --entrypoint /bin/sh pi -c \
    'if [ -n "$1" ]; then sh -c "$1"; fi; exec pi-shell-launch pi install "$2"' \
    pi "$shell_alias_setup_script" "$PI_BROWSER_EXTENSION_SOURCE"
  run_compose run --rm --service-ports pi pi-shell-launch pi "$@"
  exit $?
fi

prepare_host_shell_rc
prepare_workspace_container
validate_oauth_ports
prepare_state_lineage

# `docker compose logs` only captures the service's main process streams.
# The persistent service starts pi-session-forwarder alongside sleep, while
# this helper only preserves Pi's foreground interactive PTY via compose exec.
run_logged_pi() {
  run_compose exec pi pi-shell-launch pi-session-log "$@"
}

# State volumes are created, seeded, and repaired before the service starts;
# exec-based setup then runs inside the started service.
ensure_workspace_volumes
initialize_agent_state
repair_state_permissions
start_persistent_service
configure_pi_shell_aliases
install_browser_extension
record_state_lineage
run_logged_pi "$@"
