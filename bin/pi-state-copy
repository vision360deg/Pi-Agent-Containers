#!/usr/bin/env bash
set -euo pipefail

SOURCE=''
TARGET=''
COPY_SESSIONS=false
COPY_AUTH=false
COPY_EXTENSIONS=false
COPY_ALL=false
OVERRIDE=false
SESSION_ITEMS=()
PROVIDER_ITEMS=()
EXTENSION_ITEMS=()
REPLACE_ALL=false
TEMPORARIES=()
STAGING_ROOT=''
# Relative target paths staged under $STAGING_ROOT/items, in publish order.
PUBLISH_ITEMS=()
# Parallel arrays describing items already swapped into the target, so an
# interrupted or failed publish can be rolled back.
PUBLISHED_TARGETS=()
PUBLISHED_BACKUPS=()
PUBLISHING=false
exec 3<&0

usage() {
  cat <<'EOF'
usage: pi-state-copy --source PATH --target PATH [--sessions|--auth|--extensions] [--all] [--override]
       [--session FILE]... [--provider NAME]... [--extension REF]...

Copies Pi sessions, provider auth entries, and extensions between mounted
agent-state roots. Every selected item is staged inside the target before the
target changes; items are then published by rename, and a failed publish
restores the previous target items. Symlinked state paths are refused.
Interactive cancellation exits with status 3.
EOF
}

fail() { printf 'pi-state-copy: %s\n' "$1" >&2; exit 2; }

rollback_published() {
  local index target backup status=0
  for ((index = ${#PUBLISHED_TARGETS[@]} - 1; index >= 0; index--)); do
    target="${PUBLISHED_TARGETS[$index]}"
    backup="${PUBLISHED_BACKUPS[$index]}"
    rm -rf -- "$target" || status=1
    if [[ -n "$backup" ]]; then
      if mv -- "$backup/${target##*/}" "$target"; then
        rmdir -- "$backup" || true
      else
        printf 'pi-state-copy: rollback failed; original retained at %s\n' "$backup/${target##*/}" >&2
        status=1
      fi
    fi
  done
  PUBLISHED_TARGETS=()
  PUBLISHED_BACKUPS=()
  return "$status"
}

cleanup() {
  local path
  if [[ "$PUBLISHING" == true ]]; then
    printf 'pi-state-copy: copy interrupted; restoring the previous destination items\n' >&2
    rollback_published || true
  fi
  for path in "${TEMPORARIES[@]}"; do
    [[ ! -e "$path" && ! -L "$path" ]] || rm -rf -- "$path"
  done
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' HUP TERM

while [[ $# -gt 0 ]]; do
  case "$1" in
    --source) [[ $# -gt 1 ]] || fail '--source requires a directory'; SOURCE="$2"; shift 2 ;;
    --target) [[ $# -gt 1 ]] || fail '--target requires a directory'; TARGET="$2"; shift 2 ;;
    --sessions) COPY_SESSIONS=true; shift ;;
    --auth) COPY_AUTH=true; shift ;;
    --extensions) COPY_EXTENSIONS=true; shift ;;
    --all) COPY_ALL=true; shift ;;
    --override) OVERRIDE=true; shift ;;
    --session) [[ $# -gt 1 ]] || fail '--session requires a filename'; SESSION_ITEMS+=("$2"); COPY_SESSIONS=true; shift 2 ;;
    --provider) [[ $# -gt 1 ]] || fail '--provider requires a provider name'; PROVIDER_ITEMS+=("$2"); COPY_AUTH=true; shift 2 ;;
    --extension) [[ $# -gt 1 ]] || fail '--extension requires a package reference'; EXTENSION_ITEMS+=("$2"); COPY_EXTENSIONS=true; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unsupported option: $1" ;;
  esac
done

[[ -n "$SOURCE" ]] || fail '--source is required'
[[ -n "$TARGET" ]] || fail '--target is required'
[[ ! -L "$SOURCE" && -d "$SOURCE" ]] || fail "source is not a directory: $SOURCE"
[[ ! -L "$TARGET" && -d "$TARGET" ]] || fail "target is not a directory: $TARGET"
SOURCE="$(cd -P -- "$SOURCE" && pwd -P)"
TARGET="$(cd -P -- "$TARGET" && pwd -P)"
[[ "$SOURCE" != "$TARGET" && "$SOURCE" != "$TARGET"/* && "$TARGET" != "$SOURCE"/* ]] ||
  fail 'source and target must be separate, non-overlapping directories'

if [[ "$COPY_SESSIONS" == false && "$COPY_AUTH" == false && "$COPY_EXTENSIONS" == false ]]; then
  COPY_SESSIONS=true
  COPY_AUTH=true
  COPY_EXTENSIONS=true
fi

safe_relative_path() {
  local relative="$1"
  [[ -n "$relative" && "$relative" != /* && "$relative" != . && "$relative" != .. &&
    "$relative" != ../* && "$relative" != */.. && "$relative" != */../* &&
    "$relative" != ./* && "$relative" != */./* && "$relative" != */. && "$relative" != *//* ]]
}

# Refuse a relative path whose components, under ROOT, include a symlink so
# reads never follow links out of the source and writes never land outside
# the target. Content inside copied directories is preserved as-is by cp -a.
assert_safe_path() {
  local root="$1" relative="$2" component path="$1" remaining="$2"
  safe_relative_path "$relative" || fail "unsafe state path: $relative"
  while :; do
    component="${remaining%%/*}"
    path+="/$component"
    [[ ! -L "$path" ]] || fail "refusing symlinked state path: $path"
    [[ "$remaining" == */* ]] || break
    remaining="${remaining#*/}"
  done
}

cancel_copy() {
  printf 'pi-state-copy: copy cancelled\n' >&2
  exit 3
}

prompt_duplicate() {
  local kind="$1" item="$2" answer
  [[ "$OVERRIDE" == true || "$REPLACE_ALL" == true ]] && return 0
  while :; do
    printf 'Destination already has %s "%s": [r]eplace, [s]kip, replace [a]ll, or [q]uit? ' "$kind" "$item" >&2
    if IFS= read -r -n 1 answer <&3; then
      # Consume an already-buffered newline from piped input without waiting
      # for Enter when the user is typing directly into the terminal.
      local trailing_input=''
      IFS= read -r -t 0.05 -n 1024 trailing_input <&3 || true
      printf '\n' >&2
    else
      answer=q
    fi
    case "${answer,,}" in
      r) return 0 ;;
      s) return 1 ;;
      a) REPLACE_ALL=true; return 0 ;;
      q) cancel_copy ;;
      *) printf 'Please choose r, s, a, or q.\n' >&2 ;;
    esac
  done
}

# pick_items CATEGORY ITEM...: lets the user select items of CATEGORY into
# PICKED_ITEMS. The selection is parsed in this shell so an invalid choice
# stops the copy before anything is staged.
pick_items() {
  local category="$1" selection token index chosen
  shift
  local -a items=("$@") indexes=()
  PICKED_ITEMS=()
  if ((${#items[@]} == 0)); then
    printf 'pi-state-copy: the source state has no %s to select\n' "$category" >&2
    return 0
  fi
  printf 'Available %s:\n' "$category" >&2
  for index in "${!items[@]}"; do printf '  %s) %s\n' "$((index + 1))" "${items[$index]}" >&2; done
  printf 'Select %s by number (space or comma separated), all, or q to cancel: ' "$category" >&2
  IFS= read -r selection <&3 || [[ -n "$selection" ]] || cancel_copy
  selection="${selection//,/ }"
  case "${selection//[[:space:]]/}" in
    ''|q|Q|x|X|$'\e'*) cancel_copy ;;
    all|a) PICKED_ITEMS=("${items[@]}"); return 0 ;;
  esac
  for token in $selection; do
    [[ "$token" =~ ^[0-9]+$ ]] && index=$((10#$token - 1)) && ((index >= 0 && index < ${#items[@]})) ||
      fail "invalid $category selection: $token"
    for chosen in "${indexes[@]}"; do
      [[ "$chosen" != "$index" ]] || fail "duplicate $category selection: $token"
    done
    indexes+=("$index")
    PICKED_ITEMS+=("${items[$index]}")
  done
}

list_source_sessions() {
  [[ -d "$SOURCE/sessions" ]] || return 0
  assert_safe_path "$SOURCE" sessions
  find "$SOURCE/sessions" -mindepth 1 -maxdepth 1 -type f -print 2>/dev/null | sort
}

pick_sessions() {
  local name
  local -a items=()
  while IFS= read -r name; do items+=("${name#"$SOURCE/sessions/"}"); done < <(list_source_sessions)
  pick_items sessions "${items[@]}"
  SESSION_ITEMS=("${PICKED_ITEMS[@]}")
}

pick_providers() {
  local provider
  local -a items=()
  [[ -e "$SOURCE/auth.json" ]] && assert_safe_path "$SOURCE" auth.json
  while IFS= read -r provider; do items+=("$provider"); done < <(jq -r 'keys[]' "$SOURCE/auth.json" 2>/dev/null || true)
  pick_items providers "${items[@]}"
  PROVIDER_ITEMS=("${PICKED_ITEMS[@]}")
}

pick_extensions() {
  local package
  local -a items=()
  [[ -e "$SOURCE/settings.json" ]] && assert_safe_path "$SOURCE" settings.json
  while IFS= read -r package; do items+=("$package"); done < <(jq -r '.packages[] | if type == "string" then . else .source // empty end' "$SOURCE/settings.json" 2>/dev/null || true)
  pick_items extensions "${items[@]}"
  EXTENSION_ITEMS=("${PICKED_ITEMS[@]}")
}

# Copy a source item into the staging tree under its target-relative path.
stage_from_source() {
  local source_relative="$1" target_relative="$2" staged
  staged="$STAGING_ROOT/items/$target_relative"
  mkdir -p -- "$(dirname -- "$staged")"
  rm -rf -- "$staged"
  cp -a -- "$SOURCE/$source_relative" "$staged" || exit 2
  queue_publish "$target_relative"
}

queue_publish() {
  local item
  for item in "${PUBLISH_ITEMS[@]}"; do
    [[ "$item" != "$1" ]] || return 0
  done
  PUBLISH_ITEMS+=("$1")
}

stage_session() {
  local name="$1"
  [[ "$name" != */* && "$name" != ..* ]] || fail "unsafe session filename: $name"
  assert_safe_path "$SOURCE" "sessions/$name"
  assert_safe_path "$TARGET" "sessions/$name"
  [[ -f "$SOURCE/sessions/$name" ]] || fail "source session not found: $name"
  if [[ -e "$TARGET/sessions/$name" ]] && ! prompt_duplicate session "$name"; then return 0; fi
  stage_from_source "sessions/$name" "sessions/$name"
}

stage_sessions() {
  local name
  if ((${#SESSION_ITEMS[@]} > 0)); then
    for name in "${SESSION_ITEMS[@]}"; do stage_session "$name"; done
  else
    while IFS= read -r name; do
      stage_session "${name#"$SOURCE/sessions/"}"
    done < <(list_source_sessions)
  fi
}

validate_auth() {
  local file="$1"
  [[ ! -e "$file" ]] && return 0
  jq -e 'type == "object"' "$file" >/dev/null || fail "invalid auth JSON: $file"
}

stage_auth_provider() {
  local provider="$1" merged="$2" source_auth="$3" value
  if jq -e --arg provider "$provider" 'has($provider)' "$merged" >/dev/null && ! prompt_duplicate provider "$provider"; then
    return 0
  fi
  value="$(jq -c --arg provider "$provider" '.[$provider]' "$source_auth")"
  jq --arg provider "$provider" --argjson value "$value" '.[$provider] = $value' "$merged" > "$merged.next"
  mv -- "$merged.next" "$merged"
  AUTH_CHANGED=true
}

stage_auth() {
  local source_auth="$SOURCE/auth.json" target_auth="$TARGET/auth.json" merged="$STAGING_ROOT/items/auth.json"
  local provider encoded
  AUTH_CHANGED=false
  assert_safe_path "$SOURCE" auth.json
  assert_safe_path "$TARGET" auth.json
  [[ -e "$source_auth" ]] || return 0
  validate_auth "$source_auth"
  validate_auth "$target_auth"
  if [[ -e "$target_auth" ]]; then
    cp -a -- "$target_auth" "$merged"
  else
    (umask 077 && printf '{}\n' > "$merged")
  fi
  if ((${#PROVIDER_ITEMS[@]} > 0)); then
    for provider in "${PROVIDER_ITEMS[@]}"; do
      jq -e --arg provider "$provider" 'has($provider)' "$source_auth" >/dev/null || fail "source provider not found: $provider"
      stage_auth_provider "$provider" "$merged" "$source_auth"
    done
  else
    while IFS= read -r encoded; do
      [[ -n "$encoded" ]] || continue
      provider="$(printf '%s' "$encoded" | base64 --decode 2>/dev/null || printf '%s' "$encoded" | base64 -D)"
      stage_auth_provider "$provider" "$merged" "$source_auth"
    done < <(jq -r 'keys[] | @base64' "$source_auth")
  fi
  if [[ "$AUTH_CHANGED" == true ]]; then
    queue_publish auth.json
  else
    rm -f -- "$merged"
  fi
}

extension_reference_is_safe() {
  [[ "$1" != /* && "$1" != *'..'* ]] || fail "unsafe extension reference: $1"
}

# Prints the source-relative path of an extension, or nothing when absent.
extension_source_relative() {
  local reference="$1" package candidate
  extension_reference_is_safe "$reference"
  case "$reference" in
    npm:*)
      package="${reference#npm:}"
      for candidate in \
        "npm/node_modules/$package" \
        "node_modules/$package" \
        "npm/$package" \
        "extensions/$package"; do
        assert_safe_path "$SOURCE" "$candidate"
        [[ -e "$SOURCE/$candidate" ]] && { printf '%s' "$candidate"; return 0; }
      done
      ;;
    git:*)
      candidate="git/${reference#git:}"
      assert_safe_path "$SOURCE" "$candidate"
      [[ -e "$SOURCE/$candidate" ]] && printf '%s' "$candidate"
      ;;
    *)
      candidate="extensions/$reference"
      assert_safe_path "$SOURCE" "$candidate"
      [[ -e "$SOURCE/$candidate" ]] && printf '%s' "$candidate"
      ;;
  esac
  return 0
}

extension_target_relative() {
  extension_reference_is_safe "$1"
  case "$1" in
    npm:*) printf 'npm/node_modules/%s' "${1#npm:}" ;;
    git:*) printf 'git/%s' "${1#git:}" ;;
    *) printf 'extensions/%s' "$1" ;;
  esac
}

stage_extension() {
  local package="$1" merged="$2" source_relative target_relative
  source_relative="$(extension_source_relative "$package")"
  target_relative="$(extension_target_relative "$package")"
  assert_safe_path "$TARGET" "$target_relative"
  if [[ -z "$source_relative" ]]; then
    printf 'pi-state-copy: source extension not found; skipping: %s\n' "$package" >&2
    return 0
  fi
  if [[ ! -e "$TARGET/$target_relative" ]] || prompt_duplicate extension "$package"; then
    stage_from_source "$source_relative" "$target_relative"
  fi
  if jq -e --arg package "$package" '.packages | index($package) != null' "$merged" >/dev/null; then return 0; fi
  jq --arg package "$package" '.packages += [$package]' "$merged" > "$merged.next"
  mv -- "$merged.next" "$merged"
  SETTINGS_CHANGED=true
}

stage_extensions() {
  local settings_source="$SOURCE/settings.json" settings_target="$TARGET/settings.json" merged="$STAGING_ROOT/items/settings.json"
  local package
  SETTINGS_CHANGED=false
  assert_safe_path "$SOURCE" settings.json
  assert_safe_path "$TARGET" settings.json
  [[ -e "$settings_source" ]] || return 0
  jq -e 'type == "object" and ((.packages // []) | type == "array")' "$settings_source" >/dev/null || fail "invalid extension settings JSON: $settings_source"
  if [[ -e "$settings_target" ]]; then
    jq -e 'type == "object" and ((.packages // []) | type == "array")' "$settings_target" >/dev/null || fail "invalid extension settings JSON: $settings_target"
    jq '.packages = (.packages // [])' "$settings_target" > "$merged"
  else
    printf '{"packages":[]}\n' > "$merged"
  fi
  if ((${#EXTENSION_ITEMS[@]} > 0)); then
    for package in "${EXTENSION_ITEMS[@]}"; do stage_extension "$package" "$merged"; done
  else
    while IFS= read -r package; do stage_extension "$package" "$merged"; done < <(jq -r '.packages[] | if type == "string" then . else .source // empty end' "$settings_source")
  fi
  if [[ "$SETTINGS_CHANGED" == true ]]; then
    queue_publish settings.json
  else
    rm -f -- "$merged"
  fi
}

# Move every staged item beside its destination first, so the publish phase
# below consists only of same-directory renames, then swap each item in with
# a backup of the previous one. Any failure restores the earlier target items.
publish_staged_items() {
  local item target parent publication backup index
  local -a publications=()

  for item in "${PUBLISH_ITEMS[@]}"; do
    target="$TARGET/$item"
    parent="$(dirname -- "$target")"
    mkdir -p -- "$parent" || return 1
    assert_safe_path "$TARGET" "$item"
    publication="$(mktemp -d "$parent/.pi-state-copy-publish.XXXXXX")" || return 1
    TEMPORARIES+=("$publication")
    mv -- "$STAGING_ROOT/items/$item" "$publication/${item##*/}" || return 1
    publications+=("$publication")
  done

  PUBLISHING=true
  for index in "${!PUBLISH_ITEMS[@]}"; do
    item="${PUBLISH_ITEMS[$index]}"
    target="$TARGET/$item"
    publication="${publications[$index]}"
    backup=''
    if [[ -e "$target" || -L "$target" ]]; then
      backup="$(mktemp -d "$(dirname -- "$target")/.pi-state-copy-backup.XXXXXX")" || { publish_failed; return 1; }
      if ! mv -- "$target" "$backup/${item##*/}"; then
        rmdir -- "$backup" || true
        publish_failed
        return 1
      fi
    fi
    # Recorded before the publishing rename so an interruption between the
    # two renames still restores this item.
    PUBLISHED_TARGETS+=("$target")
    PUBLISHED_BACKUPS+=("$backup")
    if ! mv -- "$publication/${item##*/}" "$target"; then
      publish_failed
      return 1
    fi
  done
  PUBLISHING=false

  for backup in "${PUBLISHED_BACKUPS[@]}"; do
    [[ -z "$backup" ]] || rm -rf -- "$backup"
  done
}

publish_failed() {
  PUBLISHING=false
  printf 'pi-state-copy: publishing failed; restoring the previous destination items\n' >&2
  rollback_published || true
}

if [[ "$COPY_ALL" == false ]]; then
  [[ "$COPY_SESSIONS" == true && ${#SESSION_ITEMS[@]} -eq 0 ]] && pick_sessions
  [[ "$COPY_AUTH" == true && ${#PROVIDER_ITEMS[@]} -eq 0 ]] && pick_providers
  [[ "$COPY_EXTENSIONS" == true && ${#EXTENSION_ITEMS[@]} -eq 0 ]] && pick_extensions
fi

# Stage everything, including every duplicate decision, before the target
# changes; cancellation or a staging failure leaves the target untouched.
STAGING_ROOT="$(mktemp -d "$TARGET/.pi-state-copy.XXXXXX")"
TEMPORARIES+=("$STAGING_ROOT")
mkdir -- "$STAGING_ROOT/items"
[[ "$COPY_SESSIONS" == true ]] && stage_sessions
[[ "$COPY_AUTH" == true ]] && stage_auth
[[ "$COPY_EXTENSIONS" == true ]] && stage_extensions
publish_staged_items || exit 2
