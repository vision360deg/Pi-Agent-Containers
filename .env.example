# Copy this file to .env and edit the values you need.
# Do not commit .env.

# -----------------------------------------------------------------------------
# Images
# -----------------------------------------------------------------------------

# Pin these to known-good versions for reproducible builds. `latest` follows
# the current package release whenever `pi update` rebuilds the image.
PI_PACKAGE_VERSION=latest
AGENT_BROWSER_VERSION=latest

# -----------------------------------------------------------------------------
# Pi model providers
# -----------------------------------------------------------------------------

# API keys are optional. You can authenticate interactively from Pi with
# /login instead. Keep unused keys empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Optional host integrations
# -----------------------------------------------------------------------------

# Connect agent-browser to an existing CDP endpoint instead of launching the
# Chromium instance included in the container. This can be a CDP port or a
# WebSocket URL.
# AGENT_BROWSER_CDP=

# Pi's fixed browser OAuth callbacks are published only when `./bin/pi --oauth`
# is used:
#   OpenAI Codex: 1455   Anthropic: 53692   pi-antigravity: 51121
# Add custom fixed callback ports from the shell with:
#   export PI_OAUTH_CALLBACK_PORTS="7000,7001"
# `PI_OAUTH_CALLBACK_PORTS` is read by bin/pi, so placing it in this .env file
# alone does not configure the wrapper.

# The callback listener binds inside the container. Leave this at the default
# unless a provider-specific flow requires another bind address.
PI_OAUTH_CALLBACK_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Wrapper-only settings
# -----------------------------------------------------------------------------

# These are read by bin/pi from the shell environment, not by Compose. Prefer
# the command-line options shown in the README when possible.
# export PI_AGENT_CONTAINERS_CONFIG_PATH="$HOME/.config/pi-agent-containers"
# export PI_WORKSPACE="/path/to/project"
